(version 1)
; check-vault-note.py が、Vault の点検スクリプトの写し（vault/check_note.py）を動かすための Seatbelt profile。
; 値は sandbox-exec -D で受け取る（すべて realpath）:
;   VAULT        Vault（$HOME/Obsidian/main）
;   SELF         check-vault-note.py
;   COPY         写し
;   PYTHON_HOME  python3 の framework（.../Python3.framework/Versions/3.9）
; 守るのは、点検スクリプトに渡るデータ（ノート・リンク先・タグの辞書）の読み込みと、万一レビューしていないコードが
; 動いたときの外への出口。読み込みは既定で拒否し、Python の起動に要る場所と Vault の .md だけを許す。書き込み・
; ネットワーク・ほかのプログラムの起動・サービスへの接続も止める。同じ操作に複数の規則が当たるときは、後の規則が勝つ。
; 設計: docs/work/20261124_check-vault-note-hook/plan.md
(allow default)
(deny network*)
(deny file-write*)

; 起動できるのは python3 だけ（sandbox-exec が起動する bin/python3.9 と、それが起動する Resources/Python.app）。
(deny process-exec*)
(allow process-exec (subpath (param "PYTHON_HOME")))
(deny process-fork)

; launchd・LaunchServices・Keychain（securityd）などのサービス、ほかのアプリへの Apple Events、ほかのプロセスへのシグナルを使わせない。
(deny mach-lookup)
(deny appleevent-send)
(deny signal)
(allow signal (target same-sandbox))

; 読み込み（中身）は既定で拒否する。メタデータ（stat・readlink）は止めない（点検スクリプトが resolve()・exists()・
; is_dir() を使うため）。Python の起動に要る場所だけを許す: ルートのディレクトリ（起動時に libignition が開く。
; /System/Library/Sandbox/Profiles/dyld-support.sb を参照。止めると Abort trap で止まる）、システムのライブラリ
; （dyld のキャッシュは /System の下）、ロケール、タイムゾーン（/etc/localtime の実体）、python3 の framework、
; /dev/urandom（Python 3.9 が起動時のハッシュの初期化に読む。止めると起動しない。2026-11-24 に確かめた）。
(deny file-read-data)
(allow file-read-data
  (literal "/")
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/private/var/db/timezone")
  (subpath (param "PYTHON_HOME"))
  (literal "/dev/urandom")
  (literal "/dev/null")
  (literal (param "SELF"))
  (literal (param "COPY")))
; Vault の中で読めるのは .md だけ（点検スクリプトが読むのはノートと、リンク先の .md と、タグの辞書の .md）。
; ユーザー設定の Read の deny が名前で拒否する場所（secrets/・credentials/・.ssh/・.aws/・.env*・id_rsa*・id_ed25519*）は、.md でも読ませない。
(allow file-read-data
  (require-all
    (subpath (param "VAULT"))
    (regex #"\.md$")
    (require-not (regex #"/(secrets|credentials|\.ssh|\.aws)/"))
    (require-not (regex #"/(\.env|id_rsa|id_ed25519)[^/]*$"))))
