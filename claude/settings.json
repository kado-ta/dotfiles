{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(brew info *)",
      "Bash(brew search *)",
      "Bash(claude plugins *)",
      "Bash(codex --version)",
      "Bash(command -v codex)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git commit *)",
      "Bash(git check-ignore *)",
      "Bash(/usr/local/libexec/claude-push/cc-safe-push)",
      "Bash(/usr/local/libexec/claude-push/cc-safe-pr create)",
      "Bash(/usr/local/libexec/claude-push/cc-safe-pr edit)",
      "Bash(gh *)",
      "Bash(pnpm *)",
      "Bash(sfdx *)",
      "Bash(sf *)",
      "Read",
      "Edit(app/**)",
      "Edit(src/**)",
      "Edit(docs/**)",
      "Edit(scripts/**)",
      "Edit(spec/**)",
      "Edit(test/**)",
      "Edit(tests/**)",
      "Edit(.tmp/**)",
      "Edit(.gitignore)",
      "Edit(*.md)",
      "Edit(*.config.*)",
      "Edit(package.json)",
      "Edit(tsconfig.json)",
      "Edit(**/.cc-pr-request.json)",
      "Skill(claude-code-setup:claude-automation-recommender)",
      "Skill(gstack-upgrade)",
      "Skill(superpowers:brainstorming)",
      "Skill(superpowers:writing-plans)",
      "Skill(superpowers:executing-plans)",
      "Skill(superpowers:verification-before-completion)",
      "Skill(superpowers:finishing-a-development-branch)",
      "Skill(superpowers:requesting-code-review)",
      "Skill(superpowers:systematic-debugging)",
      "Skill(review)",
      "WebFetch(domain:aws.amazon.com)",
      "WebFetch(domain:awscli.amazonaws.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:repost.aws)",
      "WebFetch(domain:docs.cloud.google.com)",
      "WebFetch(domain:support.google.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:registry.circleci.com)",
      "WebFetch(domain:circleci.com)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:www.hashicorp.com)",
      "WebFetch(domain:datatracker.ietf.org)",
      "WebFetch(domain:tools.ietf.org)",
      "WebFetch(domain:www.iana.org)",
      "WebFetch(domain:www.icann.org)",
      "WebFetch(domain:techracho.bpsinc.jp)",
      "WebFetch(domain:dev.classmethod.jp)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:zenn.dev)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:yarnpkg.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:biomejs.dev)",
      "WebFetch(domain:www.ruby-lang.org)",
      "WebFetch(domain:railsguides.jp)",
      "WebFetch(domain:rubyonrails.org)",
      "WebFetch(domain:rubyapi.org)",
      "WebFetch(domain:docs.rubocop.org)",
      "WebFetch(domain:rubocop.org)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:ja.react.dev)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:mise.jdx.dev)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:www.openapis.org)",
      "WebFetch(domain:redocly.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:eu-central-1-1.aws.cloud2.influxdata.com)",
      "WebFetch(domain:learn.chatgpt.com)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:shopify.github.io)",
      "WebFetch(domain:marketplace.visualstudio.com)",
      "WebFetch(domain:open-vsx.org)",
      "WebFetch(domain:devblogs.microsoft.com)",
      "WebFetch(domain:microsoft.github.io)",
      "WebFetch(domain:help.salesforce.com)",
      "WebFetch(domain:developer.salesforce.com)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(cat **)",
      "Bash(git reset --hard *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git -c * push *)",
      "Bash(gh auth token*)",
      "Bash(gh auth status*--show-token*)",
      "Bash(gh auth status* -t*)",
      "Bash(gh auth git-credential*)",
      "Bash(sfdx org:deploy *)",
      "Bash(sf deploy *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Read(**/.env*)",
      "Read(~/**/.env*)",
      "Read(**/id_rsa*)",
      "Read(~/**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(~/dotfiles/aws/config)",
      "Read(~/**/credentials)",
      "Read(./secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/*.key)",
      "Read(~/Dev/**/*.key)",
      "Read(**/*.pem)",
      "Read(~/Dev/**/*.pem)",
      "Read(**/.pgpass)",
      "Read(~/**/.pgpass)",
      "Edit(/etc/**)",
      "Edit(**/.env*)",
      "Edit(**/.git/config)",
      "Edit(**/package-lock.json)",
      "Edit(**/pnpm-lock.yaml)",
      "Edit(**/yarn.lock)",
      "Edit(**/biome.json)",
      "Edit(**/.eslintrc)",
      "Edit(**/.eslintrc.*)",
      "Edit(**/.tflint.hcl)",
      "Edit(~/Library/Logs/cc-safe-pr/**)"
    ],
    "ask": [
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr review*)",
      "Bash(gh pr comment*)",
      "Bash(gh issue create*)",
      "Bash(gh issue close*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh repo sync*)",
      "Bash(gh api *)",
      "Edit(~/dotfiles/claude/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/validate-command.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-main-branch.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash ~/.claude/hooks/ask-gh-pr-write.sh",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r 'if (.tool_input.command // \"\" | test(\"gh pr create|cc-safe-pr create\")) then (.tool_response.stdout // \"\" | match(\"https://github\\\\.com/\\\\S+\") | .string) // empty else empty end' | { read -r url; [ -n \"$url\" ] && echo \"{\\\"systemMessage\\\": \\\"PR が作成されました: $url\\\"}\"; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/precompact-context.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/gstack/hosts/claude/hooks/timeline-stop-hook",
            "timeout": 5
          }
        ],
        "_gstack_source": "gstack-timeline-stop"
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "understand-anything@understand-anything": true,
    "crit@crit": true
  },
  "extraKnownMarketplaces": {
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "help.salesforce.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.gstack/projects"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/dotfiles/aws/credentials",
        "~/.ssh/id_*",
        "~/.ssh/config"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "/usr/local/libexec/claude-push/cc-safe-push",
      "/usr/local/libexec/claude-push/cc-safe-pr create",
      "/usr/local/libexec/claude-push/cc-safe-pr edit"
    ]
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "dark-daltonized",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(aws s3 rm:*) in ~/dotfiles — aws/credentials and aws/config are gitignored and must never be committed or uploaded",
      "Bash(git push:*) in ~/dotfiles — repo policy requires the root-owned cc-safe-push wrapper instead of raw git push"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: PUBLIC — kado-ta/dotfiles (github.com:kado-ta/dotfiles.git) is a public repository; treat any push there as publishing, and only this repo's own work belongs in it",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: `main` is the default branch; protected via active ruleset `protect-main` (gh-verified) — a local hook (`protect-main-branch.sh`) also blocks direct commits to `main`/`master`/`staging`",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo kado-ta/dotfiles and its origin remote only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: `aws/credentials` and `aws/config` (gitignored, never to be committed to this public repo); `.env` files; this repo is public, so no confidential or secret material belongs in it at all",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (dotfiles/tooling configuration for shell, editor, and AI coding agent setup)",
      "**Trusted repo**: ~/dotfiles (github.com:kado-ta/dotfiles.git) — public repository; only this repo's own work should be pushed there, and secrets/credentials are never cleared into it regardless of visibility",
      "**Org-specific CLIs**: None configured — `sf` (Salesforce CLI) and `mise` appear frequently in usage but are personal tooling, not org-specific",
      "push is only performed via the repo's own `cc-safe-push` wrapper per CLAUDE.md; raw `git push` is denied by repo policy"
    ]
  }
}
