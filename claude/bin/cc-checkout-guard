# claude -w のフック（worktree-create）。
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")
# worktree は <ホーム>/.cc-worktrees/<キー>/<名前> に作る（R22）。sandbox はホームに書けないので、
# 途中のディレクトリを作ることも、名前を変えることも、差し替えることもできない。
WORKTREE_BASE = ".cc-worktrees"
# 確かめ終わった印を置くディレクトリ。名前は . で始まれないので、置き場所とぶつからない。
VERIFIED_DIR = ".verified"
# worktree add だけに使う PATH。グローバルの設定の filter.lfs が git-lfs を呼ぶ（R3）。
WORKTREE_ADD_PATH = "/usr/bin:/bin:/opt/homebrew/bin"
# 秒。フックの timeout（60 秒）の前に、片付けまで終える。
WORKTREE_BUDGET = 50  # フックの開始からの期限。このモードの git のすべての timeout を、残りの時間にする
WORKTREE_ADD_MIN = 10  # worktree add の前に、これだけ残っていなければ作らない
WORKTREE_DISCARD_TIME = 8  # 片付けは、期限を過ぎていても、ここまで延ばして行う
# 違ったときの案内（design 6.6 の手順 6）。
# origin/HEAD は sandbox が差し替えうるので、その先へ切り替えさせずに、origin で確かめさせる（I4）。
MSG_WT_BRANCH = (
    "cc-checkout-guard: 元のチェックアウトのブランチは {current}、origin/HEAD の指す先は {origin} で、違います。"
    "origin/HEAD は差し替えられていることがあります。元のチェックアウトで git ls-remote --symref origin HEAD を実行して"
    " origin の既定ブランチを確かめ、origin/HEAD と違えば git remote set-head origin --auto で直してから、"
    "もう一度 claude -w を実行してください。同じなら、元のチェックアウトで作業してください"
    "（claude -w は、元のチェックアウトが origin/HEAD と同じブランチにあるときだけ作れます）。"
)
MSG_WT_BRANCH_EXISTS = (
    "cc-checkout-guard: ブランチ {branch} がすでにあります（Claude Code の Remove worktree は、ブランチを残します）。"
    "中身が要らないことを確かめてから、次で消して、もう一度 claude -w を実行してください:\n  {drop}"
)
MSG_WT_UNCOMMITTED = "cc-checkout-guard: 元のチェックアウトの対象のファイルに、コミットしていない変更があります。その変更を片付けてください。"
MSG_WT_BEHIND = (
    "cc-checkout-guard: 元のチェックアウトが origin より遅れています。元のチェックアウトで git pull をして"
    "（zsh の git 関数が差分を見せます）、もう一度 claude -w を実行してください。"
)
MSG_WT_REPLACED = (
    "cc-checkout-guard: origin の既定ブランチと元のチェックアウトの同じブランチが一致しているのに、中身が違います。"
    "ref か object が差し替えられたおそれがあるので、作業を止めて中身を確かめてください。"
)
MSG_WT_LEFT = "cc-checkout-guard: 作りかけの worktree を消せませんでした。中身を確かめてから消してください:"
MSG_WT_UNVERIFIED = (
    "cc-checkout-guard: {place} は、確かめ終わっていない worktree です（作る途中で止められたなど）。"
    "使わずに、次で消してから、もう一度 claude -w を実行してください:\n  {remove}\n  {branch}"
)


class GuardError(Exception):
    """確かめられない、または失敗した。str(e) が理由。"""


class Refused(Exception):
    """確かめずに止める。str(e) が出す文そのもの（MSG_UNSUPPORTED で包まない。command git を勧めない形）。"""


@dataclass(frozen=True)
class Invocation:
    cwd: Path  # -C を当てた後
    root: Path | None  # 作業ツリーのルート。リポジトリの外なら None
    config: tuple[str, ...]  # -c の値
    sub: str  # alias を展開した後。なければ ""
    args: tuple[str, ...]
    argv: tuple[str, ...]  # 元の引数
    start: Path  # 呼ばれたときのカレントディレクトリ
    home: Path  # 対象の判定（DOTFILES_PROTECTED）に使う


@dataclass(frozen=True)
class Entry:
    mode: str  # "100644"・"100755"・"120000"・"160000"・"040000"
    oid: str


@dataclass(frozen=True)
class Change:
    path: str  # ルートからの相対パス
    old: Entry | None  # 今のディスク。None は無い
    new: Entry | None  # 書かれるもの。None は削除


@dataclass(frozen=True)
class Plan:
    root: Path  # 書かれる作業ツリー
    changes: tuple[Change, ...]
    sources: tuple[str, ...]  # 属性を確かめる tree の oid。index なら INDEX
    fresh: bool = False  # 新しいディレクトリに書くとき（worktree add）
    old_root: Path | None = None  # 旧を読み、git を動かす作業ツリー（fresh のときの元のチェックアウト）。None なら root


@dataclass(frozen=True)
class Args:
    opts: tuple[tuple[str, str | None], ...]  # (名前, 値)。値を取らないものは None
    positional: tuple[str, ...]
    pathspec: tuple[str, ...] | None  # -- の後。-- がなければ None

    def has(self, *names: str) -> bool:
        return any(name in names for name, _ in self.opts)

    def last(self, *names: str) -> str | None:
        found = [name for name, _ in self.opts if name in names]
        return found[-1] if found else None

    def value(self, *names: str) -> str | None:
        found = [value for name, value in self.opts if name in names]
        return found[-1] if found else None


def user_home() -> Path:
    return Path(pwd.getpwuid(os.getuid()).pw_dir)


def in_sandbox() -> bool:
    # SANDBOX_RUNTIME などの環境変数は、呼び出し元が変えられるので見ない。
    # import 時に副作用を起こさないよう、ctypes はここでだけ使う。
    try:
        import ctypes

        lib = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
        func = lib.sandbox_check
        func.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
        func.restype = ctypes.c_int
        return func(os.getpid(), None, 0) == 1
    except Exception:
        return False


def _norm(text: str) -> str:
    return unicodedata.normalize("NFC", text).casefold()


def _parts(rel: str) -> list[str]:
    return [_norm(p) for p in rel.split("/") if p not in ("", ".")]


def is_repo_protected(rel: str) -> bool:
    """すべてのリポジトリ向けの対象か（DOTFILES_PROTECTED を除く）。"""
    parts = _parts(rel)
    if not parts:
        return False
    name = parts[-1]
    if any(p in PROTECTED_DIRS for p in parts):
        return True
    return name in PROTECTED_NAMES or name.startswith(PROTECTED_PREFIXES)


def is_protected(root: Path, rel: str, home: Path) -> bool:
    if is_repo_protected(rel):
        return True
    if os.path.realpath(root) == os.path.realpath(home / "dotfiles"):
        joined = "/".join(_parts(rel))
        for item in DOTFILES_PROTECTED:
            item = _norm(item.removeprefix("./"))
            if joined == item or joined.startswith(item + "/"):
                return True
    return False


def _hidden(ch: str) -> bool:
    category = unicodedata.category(ch)
    return category[0] == "C" or category in ("Zl", "Zp")


def _show(text: str) -> str:
    """制御文字や見えない文字を <U+XXXX> に、UTF-8 として読めないバイト（surrogateescape）を \\xNN にする。

    差分の表示で端末をだまされないため。差分を取った後に使う（先に使うと、別の中身が同じ行になる）。
    """
    if text.isprintable():
        return text
    out: list[str] = []
    for ch in text:
        code = ord(ch)
        if 0xDC80 <= code <= 0xDCFF:
            out.append(f"\\x{code - 0xDC00:02x}")
        elif ch != "\t" and _hidden(ch):
            out.append(f"<U+{code:04X}>")
        else:
            out.append(ch)
    return "".join(out)


def git_env(home: Path) -> dict[str, str]:
    return {
        "HOME": str(home), "PATH": "/usr/bin:/bin", "LC_ALL": "C",
        "GIT_CONFIG_NOSYSTEM": "1", "GIT_TERMINAL_PROMPT": "0",
        "GIT_OPTIONAL_LOCKS": "0", "GIT_NO_LAZY_FETCH": "1",
    }


# worktree-create の期限（time.monotonic() の値）。None なら期限はない（check と verify）。
_deadline: float | None = None


def _git_process(cwd: Path, *args: str, config: Sequence[str] = (), stdin: bytes | None = None,
                 env: dict[str, str] | None = None, group: bool = False) -> subprocess.CompletedProcess[bytes]:
    # 人間の -c より後に自分の値を置き、こちらを勝たせる。
    cmd = [GIT, "-C", str(cwd)]
    for value in config:
        cmd += ["-c", value]
    cmd += ["-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", "--no-pager", *args]
    timeout: float = GIT_TIMEOUT
    if _deadline is not None:
        timeout = min(timeout, _deadline - time.monotonic())
        if timeout <= 0:
            raise GuardError("時間内に終わりませんでした")
    run_env = env if env is not None else git_env(user_home())
    if not group:
        # text=True にしない。CR を LF に変換するので、CR を含むパスを別のパスと誤認する。
        return subprocess.run(
            cmd, env=run_env, input=stdin, stdin=None if stdin is not None else subprocess.DEVNULL,
            capture_output=True, check=False, timeout=timeout,
        )
    # git が動かす子（reset --hard、フィルタ、git-lfs）もまとめて止められるよう、自分の session で動かす。
    with subprocess.Popen(cmd, env=run_env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, start_new_session=True) as proc:
        try:
            out, err = proc.communicate(timeout=timeout)
        except BaseException:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            raise
    return subprocess.CompletedProcess(cmd, proc.returncode, out, err)


def run_git(cwd: Path, *args: str, config: Sequence[str] = (), stdin: bytes | None = None,
            ok: Sequence[int] = (0,)) -> bytes:
    cp = _git_process(cwd, *args, config=config, stdin=stdin)
    if cp.returncode not in ok:
        # stderr はメッセージに含めない。リポジトリ内のファイルの内容が出ることがある。
        raise GuardError(f"git {args[0]} が失敗しました")
    return cp.stdout


def parse(start: Path, argv: Sequence[str], git_env_names: Sequence[str], home: Path) -> Invocation:
    for name in git_env_names:
        if name not in ALLOWED_GIT_ENV:
            raise GuardError(f"環境変数 {name} が設定されています")
    cwd = start
    config: list[str] = []
    sub = ""
    args: tuple[str, ...] = ()
    i = 0
    while i < len(argv):
        tok = argv[i]
        if tok in HELP_GLOBALS:
            break
        if tok in SKIPPED_GLOBALS:
            pass  # 読み飛ばす
        elif tok in ("-C", "-c"):
            if i + 1 >= len(argv):
                raise GuardError(f"{tok} の値がありません")
            value = argv[i + 1]
            if tok == "-C":
                cwd = cwd / value
            else:
                if _norm(value).startswith("alias."):
                    raise GuardError("-c alias は確かめられません")
                config.append(value)
            i += 1
        elif tok.startswith("-"):
            raise GuardError(f"全体のオプション {tok} は確かめられません")
        else:
            sub, args = tok, tuple(argv[i + 1:])
            break
        i += 1
    # git は builtin を alias で置き換えない（FILE_WRITERS も builtin）。
    if sub and sub not in READ_ONLY and sub not in HANDLERS and sub not in FILE_WRITERS:
        for _ in range(ALIAS_DEPTH):
            value = os.fsdecode(run_git(cwd, "config", "--get", f"alias.{sub}", config=config, ok=(0, 1))).strip()
            if not value:
                break
            if value.startswith("!"):
                raise GuardError(f"alias {sub} はシェルコマンドです")
            try:
                words = shlex.split(value)
            except ValueError:
                raise GuardError(f"alias {sub} を読めません") from None
            if not words or words[0].startswith("-"):
                raise GuardError(f"alias {sub} は展開できません")
            sub, args = words[0], tuple(words[1:]) + args
            if sub in READ_ONLY or sub in HANDLERS or sub in FILE_WRITERS:
                break
        else:
            raise GuardError("alias の展開が深すぎます")
    try:
        root: Path | None = Path(os.fsdecode(run_git(cwd, "rev-parse", "--show-toplevel", config=config)).removesuffix("\n"))
    except GuardError:
        # .git がどこにもないときだけ、リポジトリの外とみなす。
        # .git があるのに読めないときは、外とは区別して止める。
        if any(os.path.lexists(d / ".git") for d in (cwd, *cwd.parents)):
            raise GuardError("リポジトリを読めません") from None
        root = None
    return Invocation(
        cwd=cwd, root=root, config=tuple(config), sub=sub,
        args=args, argv=tuple(argv), start=start, home=home,
    )


def _check_gitdirs(inv: Invocation) -> None:
    """inv.cwd の gitdir と共通の gitdir（git の見つけ方）に gitdir_problem があれば、Refused で止める（D2）。

    リポジトリの外なら何もしない。早道は同じ確かめ方を、git を動かさずにファイルシステムから探して行う。
    """
    cp = _git_process(inv.cwd, "rev-parse", "--path-format=absolute", "--git-dir", "--git-common-dir",
                      config=inv.config)
    if cp.returncode != 0:
        if inv.root is not None:
            raise GuardError("git のディレクトリを確かめられません")
        return
    dirs = os.fsdecode(cp.stdout).split("\n")
    if len(dirs) != 3 or dirs[2] or not all(dirs[:2]):
        raise GuardError("git のディレクトリを確かめられません")
    for gitdir in dict.fromkeys(dirs[:2]):
        try:
            found = gitdir_problem(gitdir)
        except OSError:
            raise GuardError("git のディレクトリを読めません") from None
        if found is not None:
            raise Refused(MSG_GITDIR.format(path=_show(found)))


def split_args(sub: str, args: Sequence[str], flags: frozenset[str],
               values: frozenset[str] = frozenset()) -> Args:
    """サブコマンドの引数を、許したオプション・位置引数・-- の後に分ける。"""
    opts: list[tuple[str, str | None]] = []
    positional: list[str] = []
    i = 0
    while i < len(args):
        tok = args[i]
        if tok == "--":
            return Args(tuple(opts), tuple(positional), tuple(args[i + 1:]))
        if tok == "-" or not tok.startswith("-"):
            positional.append(tok)
        elif tok.startswith("--") and "=" in tok:
            name, _, value = tok.partition("=")
            if name not in values and not (name == "--track" and name in flags):
                raise GuardError(f"{sub} のオプション {name} は確かめられません")
            opts.append((name, value))
        elif tok in flags:
            opts.append((tok, None))
        elif tok in values:
            if i + 1 >= len(args):
                raise GuardError(f"{tok} の値がありません")
            opts.append((tok, args[i + 1]))
            i += 1
        else:
            # 知らないオプション、長いオプションの省略形（--har）、まとめ書き（-qf）。
            raise GuardError(f"{sub} のオプション {tok} は確かめられません")
        i += 1
    return Args(tuple(opts), tuple(positional), None)


def _hash(root: Path, data: bytes) -> str:
    return os.fsdecode(run_git(root, "hash-object", "--no-filters", "--stdin", stdin=data)).strip()


def disk_entries(root: Path, rels: Iterable[str]) -> dict[str, Entry | None]:
    """ディスクの今の状態を lstat で調べる。中身はフィルタを通さずに hash する。"""
    found: dict[str, Entry | None] = {}
    files: list[tuple[str, str]] = []
    for rel in rels:
        path = os.path.join(root, rel)
        try:
            st = os.lstat(path)
        except (FileNotFoundError, NotADirectoryError):
            found[rel] = None
            continue
        if stat.S_ISLNK(st.st_mode):
            found[rel] = Entry(SYMLINK, _hash(root, os.readlink(os.fsencode(path))))
        elif stat.S_ISDIR(st.st_mode):
            found[rel] = Entry(TREE, "")
        elif stat.S_ISREG(st.st_mode):
            files.append((rel, "100755" if st.st_mode & stat.S_IXUSR else "100644"))
        else:
            raise GuardError(f"{rel} は通常のファイルではありません")
    for i in range(0, len(files), HASH_CHUNK):
        chunk = files[i:i + HASH_CHUNK]
        oids = os.fsdecode(run_git(root, "hash-object", "--no-filters", "--", *(rel for rel, _ in chunk))).split()
        if len(oids) != len(chunk):
            raise GuardError("hash-object の出力を読めません")
        for (rel, mode), oid in zip(chunk, oids):
            found[rel] = Entry(mode, oid)
    return found


def disk_entry(root: Path, rel: str) -> Entry | None:
    return disk_entries(root, [rel])[rel]


def tree_entries(cwd: Path, treeish: str, *, config: Sequence[str] = ()) -> dict[str, Entry]:
    entries: dict[str, Entry] = {}
    for rec in run_git(cwd, "ls-tree", "-r", "-z", "--full-tree", treeish, config=config).split(b"\0"):
        if not rec:
            continue
        meta, _, path = rec.partition(b"\t")
        mode, _type, oid = os.fsdecode(meta).split(" ")
        entries[os.fsdecode(path)] = Entry(mode, oid)
    return entries


def index_entries(cwd: Path, *pathspec: str, root: Path | None = None, home: Path | None = None,
                  config: Sequence[str] = ()) -> dict[str, Entry]:
    """index の stage 0 の entry（パスはルートから）。対象のパスに衝突（stage 1〜3）があれば止める。

    pathspec がなければ cwd の下だけを返すので、全体が要るときは cwd にルートを渡す。
    """
    args = ["ls-files", "-s", "-z", "--full-name"]
    if pathspec:
        args += ["--", *pathspec]
    entries: dict[str, Entry] = {}
    for rec in run_git(cwd, *args, config=config).split(b"\0"):
        if not rec:
            continue
        meta, _, path = rec.partition(b"\t")
        mode, oid, stage = os.fsdecode(meta).split(" ")
        rel = os.fsdecode(path)
        if stage != "0":
            if is_protected(root or cwd, rel, home or user_home()):
                raise GuardError(f"{rel} に未解決の衝突があります")
            continue
        entries[rel] = Entry(mode, oid)
    return entries


def changed_paths(inv: Invocation, *diff_args: str) -> list[str]:
    # pathspec は inv.cwd から読む。出力は diff.relative の設定によらずルートから。
    out = run_git(inv.cwd, "diff", "--name-only", "-z", "--no-relative", *DIFF_OPTS, *diff_args, config=inv.config)
    return [os.fsdecode(p) for p in out.split(b"\0") if p]


def _git_line(inv: Invocation, *args: str, ok: Sequence[int] = (0,)) -> str:
    """git の出力（前後の空白を除く）。ok に入れた 0 以外の終了コードなら ""。

    rev-parse --verify --quiet は、HEAD^@ などで oid を出しながら終了コード 1 で終わる（実測。D3）。
    """
    cp = _git_process(inv.cwd, *args, config=inv.config)
    if cp.returncode not in ok:
        # stderr はメッセージに含めない（run_git と同じ）。
        raise GuardError(f"git {args[0]} が失敗しました")
    return os.fsdecode(cp.stdout).strip() if cp.returncode == 0 else ""


def _peel(inv: Invocation, oid: str, kind: str) -> str | None:
    return _git_line(inv, "rev-parse", "--verify", "--quiet", f"{oid}^{{{kind}}}", ok=(0, 1)) or None


def _rev(inv: Invocation, rev: str, kind: str) -> str | None:
    """rev を kind（commit・tree）の oid にする。解決できなければ None。"""
    oid = _git_line(inv, "rev-parse", "--verify", "--quiet", "--end-of-options", rev, ok=(0, 1))
    return _peel(inv, oid, kind) if oid else None


def _empty_tree(inv: Invocation) -> str:
    return _git_line(inv, "hash-object", "-t", "tree", "--stdin")


def _head_tree(inv: Invocation) -> str:
    # HEAD が解決できない（コミットのない）ときは、空の tree として扱う。
    return _rev(inv, "HEAD", "tree") or _empty_tree(inv)


def _commit_tree(inv: Invocation, commit: str) -> str:
    tree = _peel(inv, commit, "tree")
    if tree is None:
        raise GuardError(f"{commit} の tree を読めません")
    return tree


def _branch_oid(inv: Invocation, name: str) -> str | None:
    """refs/heads/<name> を、git の read_ref と同じく読む。ないときは None。

    loose の ref は、大文字と小文字を区別しないファイルシステムでは、名前の大文字と小文字を区別せずに読まれる
    （for-each-ref の名前の照らし合わせは区別するので使わない）。show-ref --verify --quiet は read_ref で読み、
    あれば 0、なければ 1 で終わる。ない object を指す ref は 128（bad ref）で終わるので止める
    （同じ名前の tag に落とすと、git と違う中身を見せる）。
    """
    ref = "refs/heads/" + name
    code = _git_process(inv.cwd, "show-ref", "--verify", "--quiet", ref, config=inv.config).returncode
    if code == 1:
        return None
    if code != 0:
        raise GuardError(f"ブランチ {name} を読めません")
    return _git_line(inv, "show-ref", "--verify", "--hash", ref)


def _target(inv: Invocation, rev: str, kind: str) -> str | None:
    """switch・checkout・restore が読む rev。git と同じく、同じ名前のブランチを tag などより先に使う。"""
    if rev == "-":
        rev = "@{-1}"
    if rev == "@":
        rev = "HEAD"
    if "..." in rev:
        raise GuardError(f"{rev} は確かめられません")
    name = rev
    if rev.startswith("@{-") and rev.endswith("}"):
        # git は @{-N} をブランチの名前に戻してから refs/heads/<名前> を読む。rev-parse は同じ名前の tag を先に使う。
        # 名前に戻せない（前のチェックアウトがない、名前が HEAD など）ときは、rev-parse に落とさずに止める。
        name = _git_line(inv, "check-ref-format", "--branch", rev, ok=(0, 128))
        if not name:
            raise GuardError(f"{rev} がどのブランチかを確かめられません")
    if "@{" not in name:
        oid = _branch_oid(inv, name)
        if oid is not None:
            peeled = _peel(inv, oid, kind)
            if peeled is None:
                raise GuardError(f"{rev} を解決できません")
            return peeled
    return _rev(inv, rev, kind)


def _tree_of(inv: Invocation, rev: str) -> str:
    tree = _target(inv, rev, "tree")
    if tree is None and rev in ("HEAD", "@"):
        return _empty_tree(inv)
    if tree is None:
        raise GuardError(f"{rev} を解決できません")
    return tree


def _remote_commit(inv: Invocation, name: str) -> str | None:
    """refs/remotes/*/<name> にちょうど 1 つ当たれば、そのコミット（git の --guess と同じ）。"""
    if any(c in name for c in "*?[\\"):
        return None
    out = os.fsdecode(run_git(inv.cwd, "for-each-ref", "--format=%(refname)", "refs/remotes/", config=inv.config))
    prefix = "refs/remotes/"
    found = [r for r in out.split("\n") if r.startswith(prefix) and r[len(prefix):].partition("/")[2] == name]
    if len(found) > 1:
        # checkout.defaultRemote で git が 1 つを選ぶことがあるので、決めずに止める。
        raise GuardError(f"{name} は複数のリモートのブランチに当たります")
    return _rev(inv, found[0], "commit") if found else None


def _guess(inv: Invocation, a: Args, name: str) -> str | None:
    """-- のない checkout <name> を、リモートのブランチから作るブランチとして読むときのコミット。"""
    commit = _remote_commit(inv, name)
    if commit is None:
        return None
    if a.has("-t", "--track", "--no-track"):
        raise GuardError(f"{name} がブランチかパスかを確かめられません")
    guess = _git_line(inv, "config", "--type=bool", "--get", "checkout.guess", ok=(0, 1))
    if a.last("--guess", "--no-guess") == "--no-guess" or (guess == "false" and not a.has("--guess")):
        return None  # git はパスとして読む
    if os.path.lexists(inv.cwd / name):
        raise GuardError(f"{name} がブランチかパスかを確かめられません")
    return commit


def _gitlinks(source: dict[str, Entry], base: dict[str, Entry]) -> set[str]:
    # diff の --ignore-submodules=all は gitlink の追加と削除も隠すので、entry で比べる。
    found: set[str] = set()
    for path in source.keys() | base.keys():
        new, old = source.get(path), base.get(path)
        if new != old and any(e is not None and e.mode == GITLINK for e in (new, old)):
            found.add(path)
    return found


def _stale(inv: Invocation, pathspec: Sequence[str]) -> set[str]:
    """ディスクの中身が index と違う対象のファイル。

    git diff は index の stat と assume-unchanged を信じるが、checkout・restore・reset --hard は
    それを無視して書くので、中身で比べる。pathspec がなければ全体。
    """
    assert inv.root is not None
    if pathspec:
        entries = index_entries(inv.cwd, *pathspec, root=inv.root, home=inv.home, config=inv.config)
    else:
        entries = index_entries(inv.root, root=inv.root, home=inv.home, config=inv.config)
    targets = {p: e for p, e in entries.items() if is_protected(inv.root, p, inv.home)}
    disk = disk_entries(inv.root, targets)
    stale: set[str] = set()
    for path, entry in targets.items():
        if entry.mode == GITLINK:
            # 中身のある submodule のディレクトリは書かない。ないときだけ作られる。
            if disk[path] is None:
                stale.add(path)
        elif disk[path] != entry:
            stale.add(path)
    return stale


def _effective_at(cwd: Path, entry: Entry, config: Sequence[str] = ()) -> Entry:
    """replace の ref を効かせた中身の oid にする。書く git と同じ中身を比べるため。"""
    if entry.mode not in (*REGULAR, SYMLINK):
        return entry
    data = run_git(cwd, "cat-file", "blob", entry.oid, config=config)
    return Entry(entry.mode, _hash(cwd, data))


def _effective(inv: Invocation, entry: Entry) -> Entry:
    assert inv.root is not None
    return _effective_at(inv.root, entry, inv.config)


def _plain_checkout(inv: Invocation) -> None:
    """submodule.recurse か sparse checkout の設定（人間の -c も）が真なら止める（D3）。

    submodule.recurse では、switch などが submodule の作業ツリーにも（.git/modules から）書く。sparse checkout では、
    sandbox が .git/info/sparse-checkout を広げると、HEAD と同じで確認に出ないパスも書く（どちらも両方の git で実測）。
    作業ツリーに書く handler が、書く形と決まった後に呼ぶ。値が bool として読めなければ run_git が止める。
    """
    pattern = "^(" + "|".join(re.escape(key) for key in CHECKOUT_SETTINGS) + ")$"
    out = run_git(inv.cwd, "config", "--type=bool", "--get-regexp", pattern, config=inv.config, ok=(0, 1))
    values: dict[str, str] = {}
    for line in os.fsdecode(out).splitlines():
        key, _, value = line.partition(" ")
        values[key] = value  # 後のもの（人間の -c）が勝つ
    for key in CHECKOUT_SETTINGS:
        if values.get(key) == "true":
            raise GuardError(f"{key} が設定されています")


def _plan(inv: Invocation, source: dict[str, Entry], paths: Iterable[str], sources: tuple[str, ...],
          delete: bool) -> Plan:
    """候補のパスのうち対象のものについて、ディスクの今と、書く元の entry を比べる。"""
    assert inv.root is not None
    _plain_checkout(inv)
    root, home = inv.root, inv.home
    candidates = set(paths)
    targets = {p for p in candidates if is_protected(root, p, home)}
    # 対象のパスの親が symlink か gitlink になるときは、その親も変わるものに入れる。
    for path in candidates - targets:
        entry = source.get(path)
        if entry is not None and entry.mode in (SYMLINK, GITLINK):
            prefix = _norm(path) + "/"
            if any(_norm(t).startswith(prefix) for t in targets):
                targets.add(path)
    ordered = sorted(targets)
    disk = disk_entries(root, ordered)
    changes: list[Change] = []
    for path in ordered:
        new = source.get(path)
        if new is None and not delete:
            continue
        if new is not None:
            new = _effective(inv, new)
        if disk[path] != new:
            changes.append(Change(path, disk[path], new))
    return Plan(root=root, changes=tuple(changes), sources=sources)


def _index_missing(inv: Invocation) -> bool:
    """git が読む index のファイルがないか（git と同じく、symlink をたどって確かめる）。"""
    return not os.path.exists(os.path.join(inv.cwd, _git_line(inv, "rev-parse", "--git-path", "index")))


def _tree_plan(inv: Invocation, tree: str, *, switch: bool, force: bool) -> Plan:
    """作業ツリーを tree にする操作。switch は HEAD との差、force は index とディスクとの差を書く。"""
    source = tree_entries(inv.cwd, tree, config=inv.config)
    paths: set[str] = set()
    if switch:
        head = _head_tree(inv)
        paths |= set(changed_paths(inv, head, tree))
        paths |= _gitlinks(source, tree_entries(inv.cwd, head, config=inv.config))
        if _index_missing(inv):
            # index がないと、switch・checkout は initial checkout として、tree 全体（HEAD と同じパスも）を書き出す
            # （sandbox は index を消せる。両方の git で実測。D3）。merge はこのとき止まる（実測）が、同じく候補に入れる。
            paths |= set(source)
    if force:
        assert inv.root is not None
        index = index_entries(inv.root, root=inv.root, home=inv.home, config=inv.config)
        paths |= set(changed_paths(inv, "--cached", tree)) | _stale(inv, ()) | _gitlinks(source, index)
    return _plan(inv, source, paths, (tree,), delete=True)


def _index_plan(inv: Invocation, pathspec: Sequence[str]) -> Plan:
    assert inv.root is not None
    source = index_entries(inv.root, root=inv.root, home=inv.home, config=inv.config)
    return _plan(inv, source, _stale(inv, pathspec), (INDEX,), delete=False)


def _path_plan(inv: Invocation, tree: str | None, pathspec: Sequence[str], delete: bool) -> Plan:
    """pathspec に当たるパスを、tree（None なら index）から書く操作。"""
    if not pathspec:
        raise GuardError(f"{inv.sub} のパスがありません")
    if tree is None:
        return _index_plan(inv, pathspec)
    assert inv.root is not None
    source = tree_entries(inv.cwd, tree, config=inv.config)
    index = index_entries(inv.root, root=inv.root, home=inv.home, config=inv.config)
    paths = set(changed_paths(inv, "--cached", tree, "--", *pathspec))
    paths |= _stale(inv, pathspec) | _gitlinks(source, index)
    return _plan(inv, source, paths, (tree,), delete)


def plan_switch(inv: Invocation) -> Plan:
    a = split_args("switch", inv.args, SWITCH_FLAGS, BRANCH_VALUES)
    if a.pathspec is not None or len(a.positional) > 1:
        raise GuardError("switch の引数を確かめられません")
    force = a.has("-f", "--force", "--discard-changes")
    if a.positional:
        name = a.positional[0]
        commit = _target(inv, name, "commit") or _remote_commit(inv, name)
        if commit is None:
            raise GuardError(f"{name} を解決できません")
        return _tree_plan(inv, _commit_tree(inv, commit), switch=True, force=force)
    if not a.has(*BRANCH_VALUES, "--detach", "-d"):
        raise GuardError("切り替え先がありません")
    return _tree_plan(inv, _head_tree(inv), switch=True, force=force)


def plan_checkout(inv: Invocation) -> Plan:
    a = split_args("checkout", inv.args, CHECKOUT_FLAGS, BRANCH_VALUES)
    branch = a.has(*BRANCH_VALUES, "--detach", "-d")
    force = a.has("-f", "--force", "--discard-changes")
    delete = a.last("--overlay", "--no-overlay") == "--no-overlay"
    pos = a.positional
    if a.pathspec is not None:
        # checkout [<tree-ish>] -- <pathspec>
        if branch or len(pos) > 1:
            raise GuardError("checkout の引数を確かめられません")
        return _path_plan(inv, _tree_of(inv, pos[0]) if pos else None, a.pathspec, delete)
    if len(pos) > 1:
        # -- のない checkout <tree-ish> <path>...。最初が tree-ish でなければ、すべて index からのパス。
        if branch:
            raise GuardError("checkout の引数を確かめられません")
        tree = _target(inv, pos[0], "tree")
        return _path_plan(inv, tree, pos[1:] if tree else pos, delete)
    if not pos:
        return _tree_plan(inv, _head_tree(inv), switch=True, force=force)
    commit = _target(inv, pos[0], "commit")
    if commit is None:
        commit = _remote_commit(inv, pos[0]) if branch else _guess(inv, a, pos[0])
    if commit is not None:
        return _tree_plan(inv, _commit_tree(inv, commit), switch=True, force=force)
    if branch:
        raise GuardError(f"{pos[0]} を解決できません")
    return _path_plan(inv, None, pos, delete)


def plan_restore(inv: Invocation) -> Plan | None:
    a = split_args("restore", inv.args, RESTORE_FLAGS, RESTORE_VALUES)
    worktree = a.has("-W", "--worktree")
    staged = a.has("-S", "--staged")
    if staged and not worktree:
        return None  # index だけを書く
    source = a.value("-s", "--source")
    if source is None and staged:
        source = "HEAD"
    tree = _tree_of(inv, source) if source is not None else None
    delete = a.last("--overlay", "--no-overlay") != "--overlay"
    return _path_plan(inv, tree, a.positional + (a.pathspec or ()), delete)


def plan_checkout_index(inv: Invocation) -> Plan | None:
    a = split_args("checkout-index", inv.args, CHECKOUT_INDEX_FLAGS)
    paths = a.positional + (a.pathspec or ())
    if a.has("-a", "--all"):
        if paths:
            raise GuardError("checkout-index の引数を確かめられません")
        return _index_plan(inv, ())
    if not paths:
        return None
    # checkout-index のパスは pathspec ではないので、名前のとおりに照らし合わせる。
    return _index_plan(inv, tuple(":(literal)" + p for p in paths))


def plan_reset(inv: Invocation) -> Plan | None:
    a = split_args("reset", inv.args, RESET_FLAGS)
    if a.last(*RESET_MODES) not in RESET_WRITES:
        return None  # 作業ツリーを書かない
    if a.pathspec or len(a.positional) > 1:
        raise GuardError("reset の引数を確かめられません")
    if a.positional:
        commit = _rev(inv, a.positional[0], "commit")
        if commit is None:
            raise GuardError(f"{a.positional[0]} を解決できません")
        tree = _commit_tree(inv, commit)
    else:
        tree = _head_tree(inv)
    return _tree_plan(inv, tree, switch=False, force=True)


def _current_branch(inv: Invocation) -> str | None:
    ref = _git_line(inv, "symbolic-ref", "--quiet", "HEAD", ok=(0, 1))
    return ref.removeprefix("refs/heads/") if ref.startswith("refs/heads/") else None


def _head_commit(inv: Invocation) -> str:
    commit = _rev(inv, "HEAD", "commit")
    if commit is None:
        raise GuardError("HEAD のコミットがありません")
    return commit


def _commit_rev(inv: Invocation, rev: str) -> str:
    """merge・cherry-pick・revert・stash が読む rev。git は rev-parse と同じく解決する（同じ名前なら tag が先。実測）。"""
    if rev.startswith("^") or ".." in rev:
        raise GuardError(f"{rev} は確かめられません")
    commit = _rev(inv, rev, "commit")
    if commit is None:
        raise GuardError(f"{rev} を解決できません")
    return commit


def _no_autostash(inv: Invocation) -> None:
    """MERGE_AUTOSTASH は sandbox から置け、git は merge・merge --continue・--abort の後にその中身を書く（実測）。"""
    path = _git_line(inv, "rev-parse", "--path-format=absolute", "--git-path", "MERGE_AUTOSTASH")
    if os.path.lexists(path) or _git_line(inv, "rev-parse", "--verify", "--quiet", "MERGE_AUTOSTASH", ok=(0, 1)):
        raise GuardError("MERGE_AUTOSTASH があり、git がその中身を書きます")


def _merge_settings(inv: Invocation, *, merge: bool) -> None:
    """merge-tree が設定のプログラムを動かすか、merge-tree の結果が git と違う設定なら止める。"""
    # merge-tree は、作業ツリーの .gitattributes と .git/info/attributes（どちらも sandbox が書ける）の
    # merge 属性で、設定のドライバーを動かす（実測）。
    out = run_git(inv.cwd, "config", "--name-only", "--get-regexp", r"^merge\..+\.(driver|recursive)$",
                  config=inv.config, ok=(0, 1))
    if out.strip():
        raise GuardError(f"merge のドライバーが設定されています（{os.fsdecode(out).split()[0]}）")
    # renormalize は、merge の中でフィルタを動かす。autoStash は、merge の後に自分で作った stash を書き戻す。
    for key in ("merge.renormalize", "merge.autoStash") if merge else ("merge.renormalize",):
        if _git_line(inv, "config", "--type=bool", "--get", key, ok=(0, 1)) == "true":
            raise GuardError(f"{key} が設定されています")
    if not merge:
        return
    # 戦略と、ブランチごとの merge のオプション（-X theirs など）は、merge-tree の結果を変える。
    if _git_line(inv, "config", "--get", "pull.twohead", ok=(0, 1)) not in ("", "ort"):
        raise GuardError("pull.twohead が設定されています")
    branch = _current_branch(inv)
    if branch is not None and _git_line(inv, "config", "--get", f"branch.{branch}.mergeOptions", ok=(0, 1)):
        raise GuardError(f"branch.{branch}.mergeOptions が設定されています")
    _no_autostash(inv)


def _rerere(inv: Invocation) -> bool:
    """git が衝突したファイルに、記録した解決（.git/rr-cache。sandbox が書ける）を書きうるか。

    rerere.enabled がなければ、rr-cache があるときに書く（実測）。
    """
    value = _git_line(inv, "config", "--type=bool", "--get", "rerere.enabled", ok=(0, 1))
    if value:
        return value == "true"
    return os.path.isdir(_git_line(inv, "rev-parse", "--path-format=absolute", "--git-path", "rr-cache"))


def _require_clean_index(inv: Invocation, head: str) -> None:
    """index が HEAD と違えば止める。git は止まるか、index を tree にして merge する（stash apply・cherry-pick -n。実測）。"""
    assert inv.root is not None
    index = index_entries(inv.root, root=inv.root, home=inv.home, config=inv.config)
    if changed_paths(inv, "--cached", head) or _gitlinks(tree_entries(inv.cwd, head, config=inv.config), index):
        raise GuardError("index に HEAD と違う変更があります")


def _merged_plan(inv: Invocation, args: Sequence[str], sources: Sequence[str], *, labels: bool) -> Plan:
    """merge-tree --write-tree の結果の tree を、HEAD との差だけ書く操作（merge・cherry-pick・revert・stash apply）。

    衝突したパスでは、tree に印の入った中身があり、git も同じ中身を書く。印のラベルが git と同じになるのは
    merge と pull だけ（実測）。labels が偽なら、対象のパスが衝突したときに止める。
    """
    assert inv.root is not None
    out = run_git(inv.cwd, "merge-tree", "--write-tree", "-z", "--name-only", *args, config=inv.config, ok=(0, 1))
    items = out.split(b"\0")
    conflicts: list[str] = []
    for item in items[1:]:
        if not item:
            break  # 衝突したパスの後は、空の項目と、知らせの文
        conflicts.append(os.fsdecode(item))
    hit = sorted(p for p in conflicts if is_protected(inv.root, p, inv.home))
    if hit and not labels:
        raise GuardError(f"{hit[0]} が衝突します")
    if hit and _rerere(inv):
        raise GuardError(f"{hit[0]} が衝突し、rerere が記録した解決を書くことがあります")
    tree = os.fsdecode(items[0])
    plan = _tree_plan(inv, tree, switch=True, force=False)
    return replace(plan, sources=(tree, *sources))


def _merge_plan(inv: Invocation, rev: str) -> Plan:
    """HEAD に rev を取り込む merge。印のラベルを git merge と同じにするため、rev をそのまま merge-tree に渡す。"""
    commit = _commit_rev(inv, rev)
    _head_commit(inv)
    return _merged_plan(inv, ("HEAD", rev), (_commit_tree(inv, commit),), labels=True)


def _fetch_head(inv: Invocation) -> str:
    """git merge FETCH_HEAD が取り込むコミットの oid（ファイルに書かれたとおりの文字列）。

    git は FETCH_HEAD（sandbox が書ける）の not-for-merge でない行（oid の後が 2 つのタブ）をすべて取り込み、
    2 行以上なら octopus で merge する。rev-parse は 1 行目だけを読むので使わない（実測）。
    取り込む行がちょうど 1 つでなければ止める。
    """
    size = len(_head_commit(inv))
    # --path-format=absolute は、symlink をたどった先のパスを返す（実測）。既定の形（cwd からの相対か、
    # 最後の名前をたどらない絶対パス）を使い、symlink（/dev/zero など）や FIFO に替えられても、
    # 固まらず、メモリを使い切らないようにする（M5）。
    path = os.path.join(inv.cwd, _git_line(inv, "rev-parse", "--git-path", "FETCH_HEAD"))
    lines = _read_regular(path, FETCH_HEAD_MAX, "FETCH_HEAD").split(b"\n")
    if lines[-1] == b"":
        lines.pop()
    picked: list[str] = []
    for line in lines:
        oid = line[:size]
        if len(oid) != size or any(c not in b"0123456789abcdefABCDEF" for c in oid):
            raise GuardError("FETCH_HEAD を読めません")
        if line[size:size + 2] == b"\t\t":
            picked.append(os.fsdecode(oid))
    if len(picked) != 1:
        raise GuardError("FETCH_HEAD の取り込む行が 1 つではありません")
    return picked[0]


def plan_merge(inv: Invocation) -> Plan | None:
    if inv.args == ("--quit",):
        return None  # 作業ツリーを書かない（MERGE_AUTOSTASH は stash の一覧に入る。実測）
    if inv.args in (("--abort",), ("--continue",)):
        _no_autostash(inv)
        if inv.args == ("--continue",):
            return None  # コミットするだけ
        # --abort は reset --merge で HEAD に戻す。
        return _tree_plan(inv, _head_tree(inv), switch=False, force=True)
    a = split_args("merge", inv.args, MERGE_FLAGS, MERGE_VALUES)
    if a.pathspec is not None or len(a.positional) != 1:
        raise GuardError("merge の引数を確かめられません")
    _merge_settings(inv, merge=True)
    # git は - を @{-1} として読み、印のラベルにも @{-1} を使う（実測）。
    rev = "@{-1}" if a.positional[0] == "-" else a.positional[0]
    if rev == "FETCH_HEAD":
        # 名前がちょうど FETCH_HEAD のときだけ、git は行を読み、ラベルには oid を使う（実測。fetch_head は 1 行目）。
        rev = _fetch_head(inv)
    return _merge_plan(inv, rev)


def plan_pull(inv: Invocation) -> Plan:
    """git pull は、どの形も止める（D1）。

    pull は、確かめた後にもう一度 fetch して、その FETCH_HEAD を取り込む。確かめた中身（@{upstream}。sandbox が書ける ref）と
    git が取り込む中身が一致しない（レビューで実測）。fetch と merge @{u} に分ければ、merge はほかの merge と同じく確かめる。
    """
    raise Refused(MSG_PULL)


def _stash_push(inv: Invocation, args: Sequence[str]) -> Plan:
    """変更を保存してから HEAD に戻す。-u は追跡していないファイルも消す。"""
    assert inv.root is not None
    a = split_args("stash", args, STASH_PUSH_FLAGS, STASH_PUSH_VALUES)
    if a.positional or a.pathspec is not None:
        raise GuardError("stash の pathspec は確かめられません")
    head = _commit_tree(inv, _head_commit(inv))
    source = tree_entries(inv.cwd, head, config=inv.config)
    index = index_entries(inv.root, root=inv.root, home=inv.home, config=inv.config)
    if a.has("-k"):
        # -k は、HEAD に戻した後に index の中身を書く（実測）。対象のパスは、index が HEAD と同じときだけ確かめる。
        for path in sorted(source.keys() | index.keys()):
            if source.get(path) != index.get(path) and is_protected(inv.root, path, inv.home):
                raise GuardError(f"stash -k が {path} に index の中身を書きます")
    paths = set(changed_paths(inv, "--cached", head)) | _stale(inv, ()) | _gitlinks(source, index)
    if a.has("-u", "--include-untracked"):
        out = run_git(inv.root, "ls-files", "-z", "--others", "--exclude-standard", config=inv.config)
        # 末尾が / のもの（中のリポジトリ）は、stash -u の clean では消えない。
        paths |= {os.fsdecode(p) for p in out.split(b"\0") if p and not p.endswith(b"/")}
    return _plan(inv, source, paths, (head,), delete=True)


def _stash_apply(inv: Invocation, args: Sequence[str]) -> Plan:
    """stash を作ったときの HEAD を元にして、HEAD と stash を merge する。"""
    a = split_args("stash", args, STASH_APPLY_FLAGS)
    if a.pathspec is not None or len(a.positional) > 1:
        raise GuardError("stash の引数を確かめられません")
    rev = a.positional[0] if a.positional else "0"
    if rev and all(c in "0123456789" for c in rev):
        rev = f"refs/stash@{{{rev}}}"  # git と同じく、数字だけなら refs/stash の n 番目
    _merge_settings(inv, merge=False)
    stash = _commit_rev(inv, rev)
    base = _rev(inv, f"{stash}^1", "commit")
    if base is None or _rev(inv, f"{stash}^2", "commit") is None:
        raise GuardError(f"{rev} は stash ではありません")
    _require_clean_index(inv, _commit_tree(inv, _head_commit(inv)))
    plan = _merged_plan(inv, (f"--merge-base={base}", "HEAD", stash), (_commit_tree(inv, stash),), labels=False)
    untracked = _rev(inv, f"{stash}^3", "tree")
    if untracked is None:
        return plan
    # 追跡していないファイル（-u）は、merge の前に書かれる。
    entries = tree_entries(inv.cwd, untracked, config=inv.config)
    seen = {c.path for c in plan.changes}
    extra = [c for c in _plan(inv, entries, entries, (), delete=False).changes if c.path not in seen]
    return replace(plan, changes=plan.changes + tuple(extra), sources=(*plan.sources, untracked))


def plan_stash(inv: Invocation) -> Plan | None:
    args = inv.args
    if not args or args[0].startswith("-"):
        return _stash_push(inv, args)
    if args[0] in STASH_READS:
        return None
    if args[0] == "push":
        return _stash_push(inv, args[1:])
    if args[0] in ("apply", "pop"):
        return _stash_apply(inv, args[1:])
    raise GuardError(f"stash {args[0]} は確かめられません")


def _pick_plan(inv: Invocation, revert: bool) -> Plan:
    sub = "revert" if revert else "cherry-pick"
    a = split_args(sub, inv.args, PICK_FLAGS)
    if a.pathspec is not None or len(a.positional) != 1:
        raise GuardError(f"{sub} の引数を確かめられません")
    name = a.positional[0]
    # -e は git commit を動かし、git commit は MERGE_AUTOSTASH を書く（実測）。
    _no_autostash(inv)
    _merge_settings(inv, merge=False)
    # git は - を @{-1} として読み、rev-parse と同じく解決する（実測）。
    commit = _commit_rev(inv, "@{-1}" if name == "-" else name)
    if _rev(inv, f"{commit}^2", "commit") is not None:
        raise GuardError(f"{name} はマージコミットです")
    parent = _rev(inv, f"{commit}^1", "commit")
    if parent is None:
        raise GuardError(f"{name} には親のコミットがありません")
    _require_clean_index(inv, _commit_tree(inv, _head_commit(inv)))
    base, other = (commit, parent) if revert else (parent, commit)
    return _merged_plan(inv, (f"--merge-base={base}", "HEAD", other), (_commit_tree(inv, other),), labels=False)


def plan_cherry_pick(inv: Invocation) -> Plan:
    return _pick_plan(inv, revert=False)


def plan_revert(inv: Invocation) -> Plan:
    return _pick_plan(inv, revert=True)


def _split_letters(args: Sequence[str], letters: str) -> list[str]:
    """-- より前の、letters だけのまとめ書き（-rf）を、1 文字ずつのオプションに分ける。"""
    out: list[str] = []
    for i, tok in enumerate(args):
        if tok == "--":
            return out + list(args[i:])
        if len(tok) > 2 and tok[0] == "-" and tok[1] != "-" and all(c in letters for c in tok[1:]):
            out += ["-" + c for c in tok[1:]]
        else:
            out.append(tok)
    return out


def _no_symlink_parent(root: Path | str, rel: str) -> None:
    """rel の途中（root の下の親）に symlink があれば止める。

    rm と mv は、途中の symlink をたどって、その先（作業ツリーの外も）のファイルを消し、動かし、書く（レビューで実測。D3）。
    """
    parts = rel.split("/")
    for i in range(1, len(parts)):
        parent = "/".join(parts[:i])
        if os.path.islink(os.path.join(root, parent)):
            raise GuardError(f"{rel} の途中の {parent} が symlink です")


def plan_rm(inv: Invocation) -> Plan | None:
    a = split_args("rm", _split_letters(inv.args, RM_LETTERS), RM_FLAGS)
    if a.has("--cached", "-n"):
        return None  # 作業ツリーを書かない
    paths = a.positional + (a.pathspec or ())
    if not paths:
        raise GuardError("rm のパスがありません")
    assert inv.root is not None
    entries = index_entries(inv.cwd, *paths, root=inv.root, home=inv.home, config=inv.config)
    for path in sorted(entries):
        _no_symlink_parent(inv.root, path)
    return _plan(inv, {}, entries, (), delete=True)


def _root_rel(inv: Invocation, root: str, name: str) -> str:
    """inv.cwd から見たパスを、ルートからの相対パスにする（git と同じく、名前の上で .. をたどる）。"""
    rel = os.path.relpath(os.path.normpath(os.path.join(os.path.realpath(inv.cwd), name)), root)
    if rel in (os.curdir, os.pardir) or rel.startswith(os.pardir + os.sep):
        raise GuardError(f"{name} はリポジトリの中のパスではありません")
    return rel


def _walk_error(error: OSError) -> None:
    raise error


def _files_under(root: str, rel: str) -> list[str]:
    """rel がディレクトリなら、その下のファイルと symlink（たどらない）。ほかは rel だけ。"""
    top = os.path.join(root, rel)
    if os.path.islink(top) or not os.path.isdir(top):
        return [rel]
    found: list[str] = []
    for dirpath, dirnames, filenames in os.walk(top, onerror=_walk_error):
        names = filenames + [d for d in dirnames if os.path.islink(os.path.join(dirpath, d))]
        prefix = os.path.relpath(dirpath, root)
        found += [posixpath.join(prefix, n) for n in names]
    return found


def _unquote(name: bytes) -> bytes:
    """git が C の形で引用したパス（"a\\tb"）を元に戻す。"""
    if len(name) < 2 or name[:1] != b'"' or name[-1:] != b'"':
        return name
    body = name[1:-1]
    out = bytearray()
    i = 0
    while i < len(body):
        octal = body[i + 1:i + 4]
        if body[i] != ord("\\"):
            out.append(body[i])
            i += 1
        elif i + 1 < len(body) and body[i + 1] in C_ESCAPES:
            out.append(C_ESCAPES[body[i + 1]])
            i += 2
        elif len(octal) == 3 and all(ord("0") <= b <= ord("7") for b in octal):
            out.append(int(octal, 8))
            i += 4
        else:
            raise GuardError("clean の出力を読めません")
    return bytes(out)


def _clean_options(args: Sequence[str]) -> tuple[set[str], int]:
    """clean のオプションを短い名前の集合にし、-- の位置（なければ引数の数）と一緒に返す。

    知らないオプションと、長いオプションの省略形（--dry）は止める。-e は値を取る（-de<pattern> の形も）。
    """
    letters: set[str] = set()
    i = 0
    while i < len(args):
        tok = args[i]
        if tok == "--":
            return letters, i
        if tok in CLEAN_LONG:
            letters.add(CLEAN_LONG[tok])
        elif tok == "--exclude":
            i += 1
        elif tok.startswith("--"):
            if not tok.startswith("--exclude="):
                raise GuardError(f"clean のオプション {tok} は確かめられません")
        elif tok.startswith("-") and tok != "-":
            for j, ch in enumerate(tok[1:], 1):
                if ch == "e":
                    if j == len(tok) - 1:
                        i += 1  # 値は次の引数
                    break  # 残りは値
                if ch not in CLEAN_LETTERS:
                    raise GuardError(f"clean のオプション {tok} は確かめられません")
                letters.add(ch)
        i += 1
    return letters, len(args)


def plan_clean(inv: Invocation) -> Plan | None:
    letters, end = _clean_options(inv.args)
    if "n" in letters:
        return None
    if "i" in letters:
        raise GuardError("clean -i は確かめられません")
    assert inv.root is not None
    # 同じ引数で、消すものを数える。-q は一覧も消すので打ち消す（実測）。-f は残す（-f -f で消える中のリポジトリも数える）。
    args = ["clean", "--dry-run", *inv.args[:end], "--no-quiet", *inv.args[end:]]
    out = run_git(inv.cwd, *args, config=inv.config)
    root = os.path.realpath(inv.root)
    prefix = b"Would remove "
    paths: list[str] = []
    for line in out.split(b"\n"):
        if line.startswith(prefix):
            rel = _root_rel(inv, root, os.fsdecode(_unquote(line[len(prefix):])))
            paths += _files_under(root, rel)
    return _plan(inv, {}, paths, (), delete=True)


def plan_mv(inv: Invocation) -> Plan | None:
    """対象のファイルが動く（行き先が対象になる、対象を動かす）mv は、確かめずに止める。"""
    a = split_args("mv", inv.args, MV_FLAGS)
    names = a.positional + (a.pathspec or ())
    if len(names) < 2:
        raise GuardError("mv の引数を確かめられません")
    assert inv.root is not None
    root = os.path.realpath(inv.root)
    *sources, dest = [_root_rel(inv, root, n) for n in names]
    into = len(sources) > 1 or os.path.isdir(os.path.join(root, dest))
    for src in sources:
        target = posixpath.join(dest, posixpath.basename(src)) if into else dest
        # ディレクトリを動かすときは、その下（index と、追跡していないファイル）も動く。
        index = index_entries(inv.root, ":(literal)" + src, root=inv.root, home=inv.home, config=inv.config)
        for path in sorted({src, *index, *_files_under(root, src)}):
            for moved in (path, target + path[len(src):]):
                _no_symlink_parent(root, moved)
                if is_protected(inv.root, moved, inv.home):
                    raise GuardError(f"{moved} が動きます")
    _plain_checkout(inv)
    return None


def _main_checkout(inv: Invocation) -> Path | None:
    """元のチェックアウトのルート（共通の gitdir の親）。bare のリポジトリには無いので None。

    --separate-git-dir などで共通の gitdir の名前が .git でないときは、git 自身も場所を知らないので止める（R19）。
    """
    if _git_line(inv, "config", "--type=bool", "--get", "core.bare", ok=(0, 1)) == "true":
        return None
    common = Path(_git_line(inv, "rev-parse", "--path-format=absolute", "--git-common-dir"))
    if common.name != ".git":
        raise GuardError("元のチェックアウトを確かめられません")
    return common.parent


def _main_root(inv: Invocation) -> Path:
    main = _main_checkout(inv)
    if main is None:
        raise GuardError("元のチェックアウトを確かめられません")
    return main


def compare_with_main(main_root: Path, cwd: Path, treeish: str) -> list[Change]:
    """treeish の tree を、元のチェックアウトのディスクと比べる。すべてのリポジトリ向けの対象だけを見る。

    旧は元のチェックアウトのディスク、新は tree の entry（replace を効かせた中身）。対象のパスの親が tree で
    symlink・gitlink になるときは、その親も比べる。
    """
    tree = tree_entries(cwd, treeish)
    index = index_entries(main_root, root=main_root, home=user_home())
    protected = {p for p in tree.keys() | index.keys() if is_repo_protected(p)}
    parents = {
        p for p, e in tree.items()
        if p not in protected and e.mode in (SYMLINK, GITLINK)
        and any(_norm(t).startswith(_norm(p) + "/") for t in protected)
    }
    ordered = sorted(protected | parents)
    disk = disk_entries(main_root, ordered)
    changes: list[Change] = []
    for path in ordered:
        new = tree.get(path)
        if new is not None:
            new = _effective_at(cwd, new)
        if disk[path] != new:
            changes.append(Change(path, disk[path], new))
    return changes


def _worktree_target(inv: Invocation, a: Args, path: str, rev: str | None) -> str:
    """worktree add が新しい作業ツリーに書くコミット。git の解決に合わせる（実測）。"""
    named = a.has("-b", "-B", "-d", "--detach")
    if rev is None:
        if not named:
            # git は、パスの最後の名前のブランチがあればそれを、なければ（guessRemote なら）リモートのブランチを使う。
            name = os.path.basename(path.rstrip("/"))
            if not name or name.startswith("-") or "@{" in name:
                raise GuardError(f"{path} から作るブランチを確かめられません")
            oid = _branch_oid(inv, name)
            if oid is not None:
                return _commit_rev(inv, oid)
            guess = a.last("--guess-remote", "--no-guess-remote")
            if guess is None and _git_line(inv, "config", "--type=bool", "--get", "worktree.guessRemote",
                                           ok=(0, 1)) == "true":
                guess = "--guess-remote"
            if guess == "--guess-remote":
                remote = _remote_commit(inv, name)
                if remote is not None:
                    return remote
        return _head_commit(inv)
    if rev == "-":
        rev = "@{-1}"
    if named:
        # -b・-B・--detach では、rev-parse と同じく tag が先（実測）。
        return _commit_rev(inv, rev)
    # ほかは switch と同じく、同じ名前のブランチが先。なければリモートのブランチ（実測）。
    commit = _target(inv, rev, "commit") or _remote_commit(inv, rev)
    if commit is None:
        raise GuardError(f"{rev} を解決できません")
    return commit


def _physical(inv: Invocation, name: str) -> str:
    """cwd から見た name の絶対パス。

    途中が symlink だと（symlink の後の .. を含む）、git が書く場所は名前の上の場所と違う（実測）。決めきれないので止める。
    """
    joined = os.path.join(os.path.realpath(inv.cwd), name)
    path = os.path.normpath(joined)
    if os.path.realpath(joined) != path:
        raise GuardError(f"{name} の途中に symlink があります")
    return path


def _inside(place: str, root: Path) -> str | None:
    """place が root の中なら、root からの相対パス。

    パスの文字列ではなく、ある祖先のファイルの同一性（st_dev, st_ino）で比べる（大文字と小文字、Unicode の正規化の違いでも同じディレクトリ）。
    """
    target = os.stat(root)
    path, tail = place, []
    while True:
        try:
            st = os.stat(path)
        except (FileNotFoundError, NotADirectoryError):
            st = None
        if st is not None and (st.st_dev, st.st_ino) == (target.st_dev, target.st_ino):
            return "/".join(reversed(tail))
        parent, name = os.path.split(path)
        if parent == path:
            return None
        tail.append(name)
        path = parent


def _protected_place(inv: Invocation, place: str) -> None:
    """place（物理パス）が、今か元のチェックアウトの対象のパス（またはその下）なら止める。

    新しい作業ツリーの中のファイルは、そのチェックアウトから見ると対象のパスになる（.claude/skills/x/SKILL.md など）。
    """
    assert inv.root is not None
    main = _main_checkout(inv)
    for root in (inv.root, *([main] if main is not None else [])):
        rel = _inside(place, root)
        if rel and is_protected(root, rel, inv.home):
            raise GuardError(f"{place} は自動で読み込まれるパスの中です")


def _worktree_candidates(inv: Invocation, arg: str) -> set[str]:
    """arg が指しうる worktree の、登録されたパス。

    git の find_worktree は、登録されたパスの後ろ（名前の区切りから）が arg と一致するものがちょうど 1 つならそれを、
    なければ arg の実パスと同じものを使う。どちらの候補も集める（呼ぶ側は、1 つに決まらなければ止める）。
    """
    out = run_git(inv.cwd, "worktree", "list", "--porcelain", "-z", config=inv.config)
    paths = [os.fsdecode(rec[len(b"worktree "):]) for rec in out.split(b"\0") if rec.startswith(b"worktree ")]
    key = _norm(arg)
    found = {p for p in paths if key and (_norm(p) == key or _norm(p).endswith("/" + key))}
    target = os.path.join(os.path.realpath(inv.cwd), arg)
    for p in paths:
        try:
            if os.path.samefile(p, target):
                found.add(p)
        except OSError:
            continue  # ない worktree（prunable）と、ない arg
    return found


def _worktree_name(inv: Invocation, arg: str) -> str:
    """worktree move が動かす worktree の、登録されたパスの最後の名前。1 つに決まらなければ止める。"""
    names = {os.path.basename(p) for p in _worktree_candidates(inv, arg)}
    if len(names) != 1 or "" in names:
        raise GuardError(f"{arg} がどの worktree かを確かめられません")
    return names.pop()


def _read_regular(path: str, limit: int, what: str) -> bytes:
    """path を、symlink をたどらずに、通常のファイルとして limit バイトまで読む。ほかの種類と、大きすぎるものは止める。

    O_NONBLOCK で開くので、FIFO に替えられていても固まらない（種類を確かめてから読む）。
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        raise GuardError(f"{what} を読めません") from None
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise GuardError(f"{what} は通常のファイルではありません")
        data = f.read(limit + 1)
    if len(data) > limit:
        raise GuardError(f"{what} が大きすぎます")
    return data


def _worktree_remove(inv: Invocation, args: Sequence[str]) -> None:
    """worktree remove が消す場所を、git と同じく決めて確かめる（I3）。

    git は、登録（<共通の gitdir>/worktrees/<id>/gitdir。sandbox が書けうる）の指すパスを、中身ごと消す。
    登録のパスに // や symlink があると、名前の上では一致しても、別の場所を消す（最終レビューで実測）。
    登録のパスが実パス（normpath と realpath が同じ）の実体のディレクトリで、その .git が通常のファイルで
    この登録を指し、共通の gitdir の中でないときだけ許可する。
    """
    a = split_args("worktree", args, WORKTREE_MOVE_FLAGS)
    pos = a.positional + (a.pathspec or ())
    if len(pos) != 1:
        raise GuardError("worktree remove の引数を確かめられません")
    found = _worktree_candidates(inv, pos[0])
    if len(found) != 1:
        raise GuardError(f"{pos[0]} がどの worktree かを確かめられません")
    place = found.pop()
    if place != os.path.normpath(place) or place != os.path.realpath(place):
        raise GuardError(f"worktree の登録 {place} は実パスではありません（// や symlink を含みます）")
    try:
        is_dir = stat.S_ISDIR(os.lstat(place).st_mode)
    except OSError:
        is_dir = False
    if not is_dir:
        raise GuardError(f"worktree {place} のディレクトリがありません")
    common = _git_line(inv, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if _inside(place, Path(common)) is not None:
        raise GuardError(f"worktree {place} は git のディレクトリの中です")
    # git の read_gitfile と同じく、gitdir: の後のパス（相対なら .git ファイルの場所から）を実パスにして比べる。
    gitfile = os.fsdecode(_read_regular(os.path.join(place, ".git"), GITFILE_MAX, f"{place}/.git")).rstrip("\r\n")
    back = os.path.realpath(os.path.join(place, gitfile.removeprefix("gitdir: ")))
    registered = ""
    if gitfile.startswith("gitdir: ") and os.path.dirname(back) == os.path.realpath(os.path.join(common, "worktrees")):
        # git の get_worktrees と同じく、gitdir ファイルの中身の末尾の空白と /.git を除いたものが登録のパス。
        text = os.fsdecode(_read_regular(os.path.join(back, "gitdir"), GITFILE_MAX, "worktree の登録")).rstrip()
        registered = text.removesuffix("/.git")
    if registered != place:
        raise GuardError(f"{place}/.git がこの worktree の登録を指していません")


def _worktree_move(inv: Invocation, args: Sequence[str]) -> None:
    """worktree move の行き先を、git と同じく決めて確かめる（R18）。"""
    a = split_args("worktree", args, WORKTREE_MOVE_FLAGS)
    pos = a.positional + (a.pathspec or ())
    if len(pos) != 2:
        raise GuardError("worktree move の引数を確かめられません")
    place = _physical(inv, pos[1])
    if os.path.isdir(place):
        # git は、行き先がディレクトリなら、その中に、登録された worktree のパスの最後の名前で動かす。
        place = posixpath.join(place, _worktree_name(inv, pos[0]))
    _protected_place(inv, place)


def plan_worktree(inv: Invocation) -> Plan | None:
    if not inv.args:
        raise GuardError("worktree の引数を確かめられません")
    sub = inv.args[0]
    if sub in WORKTREE_OTHERS:
        return None
    if sub == "move":
        _worktree_move(inv, inv.args[1:])
        return None  # 中身は書かない
    if sub == "remove":
        _worktree_remove(inv, inv.args[1:])
        return None  # 消すだけで、中身は書かない
    if sub != "add":
        raise GuardError(f"worktree {sub} は確かめられません")
    a = split_args("worktree", inv.args[1:], WORKTREE_ADD_FLAGS, WORKTREE_ADD_VALUES)
    pos = a.positional + (a.pathspec or ())
    if not 1 <= len(pos) <= 2:
        raise GuardError("worktree add の引数を確かめられません")
    root = _physical(inv, pos[0])
    _protected_place(inv, root)
    if a.last("--checkout", "--no-checkout") == "--no-checkout":
        return None
    _plain_checkout(inv)
    commit = _worktree_target(inv, a, pos[0], pos[1] if len(pos) == 2 else None)
    tree = _commit_tree(inv, commit)
    main = _main_root(inv)
    # 新しいディレクトリはまだ読まれないので、元のチェックアウトの中身と比べる。
    changes = compare_with_main(main, inv.cwd, tree)
    return Plan(root=Path(root), changes=tuple(changes), sources=(tree,), fresh=True, old_root=main)


def plan_commit(inv: Invocation) -> Plan | None:
    """commit（--amend を含む。MERGE_HEAD がなくても）は、コミットの後に MERGE_AUTOSTASH の中身を書く（実測）。

    それ以外は作業ツリーを書かないので、オプションは読まない。
    """
    _no_autostash(inv)
    return None


# サブコマンド名 -> 確認の内容を作る関数。None は作業ツリーの対象を書かない。
HANDLERS: dict[str, Callable[[Invocation], Plan | None]] = {
    "commit": plan_commit,
    "switch": plan_switch,
    "checkout": plan_checkout,
    "restore": plan_restore,
    "checkout-index": plan_checkout_index,
    "reset": plan_reset,
    "merge": plan_merge,
    "pull": plan_pull,
    "stash": plan_stash,
    "cherry-pick": plan_cherry_pick,
    "revert": plan_revert,
    "rm": plan_rm,
    "clean": plan_clean,
    "mv": plan_mv,
    "worktree": plan_worktree,
}


def _attr_danger(inv: Invocation, paths: Sequence[str], where: Sequence[str]) -> str | None:
    assert inv.root is not None
    data = b"".join(os.fsencode(p) + b"\0" for p in paths)
    out = run_git(inv.root, "check-attr", "-z", "--stdin", *where, *DANGEROUS_ATTRS, config=inv.config, stdin=data)
    items = [os.fsdecode(x) for x in out.split(b"\0")]
    for i in range(0, len(items) - 2, 3):
        path, attr, value = items[i:i + 3]
        if value not in ("unspecified", "unset"):
            return MSG_DANGER.format(path=_show(path), kind=f"書くときに中身を変える属性（{attr}）")
    return None


def danger(plan: Plan, inv: Invocation) -> str | None:
    for c in plan.changes:
        if c.new is not None and c.new.mode in (SYMLINK, GITLINK):
            kind = "symlink" if c.new.mode == SYMLINK else "submodule（gitlink）"
            return MSG_DANGER.format(path=_show(c.path), kind=kind)
    # NUL を含む中身は、差分で見せても読めないので、聞かずに止める。
    for c in plan.changes:
        if c.new is not None and c.new.mode in REGULAR:
            if b"\0" in run_git(plan.old_root or plan.root, "cat-file", "blob", c.new.oid, config=inv.config):
                return MSG_DANGER.format(path=_show(c.path), kind="バイナリの中身")
    for c in plan.changes:
        parts = c.path.split("/")
        for i in range(1, len(parts)):
            parent = "/".join(parts[:i])
            if os.path.islink(os.path.join(plan.root, parent)):
                return MSG_DANGER.format(path=_show(parent), kind="symlink")
    paths = [c.path for c in plan.changes if c.new is not None]
    if plan.fresh:
        # 新しい作業ツリーには、元のチェックアウトと同じ中身の対象も書かれ、属性はそれにも効く。
        paths = sorted(set(paths) | set(_fresh_entries(plan, inv)))
    if not paths:
        return None
    # 書くときの属性は、作業ツリー・index・書く元の tree のどれからも来うる。
    wheres: list[tuple[str, ...]] = [(), ("--cached",)]
    wheres += [(f"--source={s}",) for s in plan.sources if s != INDEX]
    for where in wheres:
        reason = _attr_danger(inv, paths, where)
        if reason is not None:
            return reason
    return None


def _mark(c: Change) -> str:
    if c.old is None:
        return "追加"
    if c.new is None:
        return "削除"
    if c.old.mode != c.new.mode:
        return f"モードの変更（{c.old.mode}→{c.new.mode}）"
    return "変更"


def listing(plan: Plan) -> str:
    lines = [MSG_CHANGES] + [f"  {_mark(c)} {_show(c.path)}" for c in plan.changes]
    return "\n".join(lines) + "\n"


def _disk_bytes(root: Path, rel: str, entry: Entry | None) -> bytes:
    path = os.path.join(root, rel)
    if entry is None or entry.mode not in (*REGULAR, SYMLINK):
        return b""
    if entry.mode == SYMLINK:
        return os.readlink(os.fsencode(path))
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as f:
        return f.read()


def _lines(data: bytes) -> list[str]:
    """差分の行。UTF-8 として読めないバイトは surrogateescape で残し、表示のときに \\xNN にする。

    backslashreplace で読むと、読めないバイトと「\\xNN」という文字列が同じ行になり、差分から消える。
    """
    lines = data.decode("utf-8", "surrogateescape").split("\n")
    if lines[-1] == "":
        lines.pop()
    return lines


def render(plan: Plan, config: Sequence[str] = ()) -> str:
    """変わるファイルの一覧と差分。config は人間の -c（書く git と同じ見え方で中身を読む。M6）。"""
    out = [listing(plan)]
    base = plan.old_root or plan.root
    for c in plan.changes:
        new_data = b""
        if c.new is not None and c.new.mode in (*REGULAR, SYMLINK):
            new_data = run_git(base, "cat-file", "blob", c.new.oid, config=config)
        old, new = _lines(_disk_bytes(base, c.path, c.old)), _lines(new_data)
        before = f"a/{c.path}" if c.old is not None else "/dev/null"
        after = f"b/{c.path}" if c.new is not None else "/dev/null"
        # 差分を取ってから表示用に変える。逆にすると、実際の ESC と「<U+001B>」という文字列が同じ行になる。
        diff = [_show(line) for line in difflib.unified_diff(old, new, before, after, lineterm="")]
        if diff:
            out.append("\n".join(diff) + "\n")
    return "".join(out)


def _enc(entry: Entry | None) -> list[str] | None:
    return None if entry is None else [entry.mode, entry.oid]


def _dec(value: object) -> Entry | None:
    if value is None:
        return None
    if isinstance(value, list) and len(value) == 2 and all(isinstance(v, str) for v in value):
        return Entry(value[0], value[1])
    raise ValueError("entry")


def _fresh_entries(plan: Plan, inv: Invocation) -> dict[str, Entry]:
    """新しい作業ツリーに書かれる対象（書く元の tree の対象すべて。元のチェックアウトと同じものも含む）。"""
    assert plan.old_root is not None
    found: dict[str, Entry] = {}
    for tree in plan.sources:
        for path, entry in tree_entries(plan.old_root, tree, config=inv.config).items():
            if is_protected(plan.root, path, inv.home):
                found[path] = entry
    return found


def state_of(plan: Plan, inv: Invocation) -> str:
    """verify に渡す状態。変わるファイルは [旧, 新]、index にある変わらない対象は [今, 今]。

    fresh（新しい作業ツリー）では、書く元の tree の対象をすべて [null, 新] にする（変わらないものも書かれる）。
    """
    expect: dict[str, list[list[str] | None]] = {}
    if plan.fresh:
        assert plan.old_root is not None
        for path, entry in _fresh_entries(plan, inv).items():
            expect[path] = [None, _enc(_effective_at(plan.old_root, entry, inv.config))]
    else:
        entries = index_entries(plan.root, root=plan.root, home=inv.home, config=inv.config)
        targets = [p for p in entries if is_protected(plan.root, p, inv.home)]
        for path, entry in disk_entries(plan.root, targets).items():
            expect[path] = [_enc(entry), _enc(entry)]
    for c in plan.changes:
        expect[c.path] = [None if plan.fresh else _enc(c.old), _enc(c.new)]
    return json.dumps({"root": str(plan.root), "expect": expect}, sort_keys=True, separators=(",", ":"))


def _index_paths(root: Path) -> set[str]:
    """index のすべてのパス（stage を問わない。ルートから）。"""
    out = run_git(root, "ls-files", "-s", "-z", "--full-name")
    return {os.fsdecode(rec.partition(b"\t")[2]) for rec in out.split(b"\0") if rec}


def verify(state: str, stderr: TextIO) -> int:
    """git の後に、対象のファイルが確認の旧か新のどちらかと一致するかを確かめる。"""
    try:
        data = json.loads(state)
        root = Path(data["root"])
        allowed: dict[str, tuple[Entry | None, ...]] = {}
        for rel, pair in data["expect"].items():
            if not isinstance(pair, list) or len(pair) != 2:
                raise ValueError("expect")
            allowed[rel] = tuple(_dec(v) for v in pair)
        now = disk_entries(root, allowed)
        found = {rel for rel, pair in allowed.items() if now[rel] not in pair}
        # 確認したときに index になかった対象のファイルを、git が書いていないか（確認の後に ref を差し替えられた場合）。
        home = user_home()
        for rel in _index_paths(root) - set(allowed):
            if is_protected(root, rel, home) and os.path.lexists(os.path.join(root, rel)):
                found.add(rel)
        bad = sorted(found)
    except Exception as e:
        stderr.write(MSG_ERROR.format(reason=type(e).__name__) + "\n")
        return EXIT_STOP
    if bad:
        stderr.write(MSG_VERIFY + "\n" + "".join(f"  {_show(rel)}\n" for rel in bad))
        return EXIT_STOP
    return EXIT_ALLOW


def check(argv: Sequence[str], *, start: Path, git_env: Sequence[str], home: Path,
          stdin: TextIO, stderr: TextIO, tty: bool) -> tuple[int, str]:
    if in_sandbox():
        return EXIT_ALLOW, ""
    try:
        inv = parse(start, argv, git_env, home)
        # git は gitdir の symlink の先に書くので、何を許可する前にも確かめる（D2）。
        _check_gitdirs(inv)
        # ファイルに書く形は、リポジトリの外でも止める（書き先は絶対パスで対象を指せる）。
        writes = file_writes(inv.sub, inv.args)
        if writes is not None:
            raise GuardError(writes)
        # 人間の -c init.templateDir も、作り直しの init でテンプレートを .git/hooks などに写す（実測。R24）。
        if inv.sub == "init" and any(_norm(c).partition("=")[0] == "init.templatedir" for c in inv.config):
            raise GuardError("init の -c init.templateDir はファイルに書きます")
        # -h / --help がヘルプになるのは先頭の引数のときだけ（-m の値やパスのこともある）。
        if inv.sub == "" or inv.sub in READ_ONLY or inv.args[:1] in (("-h",), ("--help",)) or inv.root is None:
            return EXIT_ALLOW, ""
        handler = HANDLERS.get(inv.sub)
        if handler is None:
            raise GuardError(f"{inv.sub} は確かめられません")
        plan = handler(inv)
        if plan is None:
            return EXIT_ALLOW, ""
        reason = danger(plan, inv)
        if reason is not None:
            stderr.write(reason + "\n")
            return EXIT_STOP, ""
        state = state_of(plan, inv)
        if not plan.changes:
            return EXIT_ALLOW, state
        if not tty:
            command = " ".join(shlex.quote(w) for w in ("git", "-C", str(inv.start), *inv.argv))
            stderr.write(listing(plan) + MSG_NO_TTY.format(command=command) + "\n")
            return EXIT_STOP, ""
        stderr.write(render(plan, inv.config) + MSG_ASK)
        stderr.flush()
        answer = stdin.readline()
        newline = "" if answer.endswith("\n") else "\n"
        if answer.strip().lower() in ("y", "yes"):
            # 人間が読んでいる間に ref などを差し替えられていないか、同じ計算をもう一度して比べる（I1）。
            # gitdir も確かめ直す（D2）。残る窓は、ここから git が書くまでの短い時間だけ（verify が後から見つける）。
            try:
                _check_gitdirs(inv)
                again = handler(inv)
                same = (again is not None and again.changes == plan.changes and danger(again, inv) is None
                        and state_of(again, inv) == state)
            except (GuardError, Refused):
                same = False
            if same:
                return EXIT_ALLOW, state
            stderr.write(newline + MSG_CHANGED_WHILE_ASKING + "\n")
            return EXIT_STOP, ""
        stderr.write(newline + MSG_DECLINED + "\n")
        return EXIT_STOP, ""
    except Refused as e:
        stderr.write(str(e) + "\n")
        return EXIT_STOP, ""
    except GuardError as e:
        stderr.write(MSG_UNSUPPORTED.format(reason=_show(str(e))) + "\n")
        return EXIT_STOP, ""
    except Exception as e:
        stderr.write(MSG_ERROR.format(reason=type(e).__name__) + "\n")
        return EXIT_STOP, ""


def _hook_inv(cwd: Path, root: Path | None, home: Path) -> Invocation:
    """フックの git を cwd で動かすための Invocation。人間の -c はない。"""
    return Invocation(cwd=cwd, root=root, config=(), sub="worktree", args=(), argv=(), start=cwd, home=home)


def _registered(inv: Invocation, place: str) -> bool:
    """place が、このリポジトリの worktree として登録されているか（ディレクトリのない登録も含む）。"""
    out = run_git(inv.cwd, "worktree", "list", "--porcelain", "-z")
    for rec in out.split(b"\0"):
        if not rec.startswith(b"worktree "):
            continue
        path = os.fsdecode(rec[len(b"worktree "):])
        if _norm(path) == _norm(place):
            return True
        try:
            if os.path.samefile(path, place):
                return True
        except OSError:
            continue  # ない worktree（prunable）と、ない place
    return False


def _tree_danger(main: Path, tree: str) -> str | None:
    """作成元の tree の対象が symlink か gitlink なら理由。元のチェックアウトと同じでも、新しい worktree に書かれる。"""
    for path, entry in sorted(tree_entries(main, tree).items()):
        if entry.mode in (SYMLINK, GITLINK) and is_repo_protected(path):
            kind = "symlink" if entry.mode == SYMLINK else "submodule（gitlink）"
            return MSG_DANGER.format(path=_show(path), kind=kind)
    return None


def _created_diff(main: Path, place: Path) -> tuple[str | None, list[Change]]:
    """作った worktree の対象を、元のチェックアウトのディスクと比べる。

    対象は、どちらかの index にある、すべてのリポジトリ向けの対象のパス。どちらかで、そのパスか親が symlink なら
    理由を返す（lstat は親の symlink をたどるので、たどった先の中身で同じに見える）。ほかは違ったパスを返す。
    """
    paths = sorted(p for p in _index_paths(place) | _index_paths(main) if is_repo_protected(p))
    for root in (place, main):
        for path in paths:
            parts = path.split("/")
            for i in range(1, len(parts) + 1):
                sub = "/".join(parts[:i])
                if os.path.islink(os.path.join(root, sub)):
                    return MSG_DANGER.format(path=_show(sub), kind="symlink"), []
    new = disk_entries(place, paths)
    old = disk_entries(main, paths)
    return None, [Change(p, old[p], new[p]) for p in paths if old[p] != new[p]]


def _private_dir(path: Path) -> None:
    """path を、自分だけが書ける実体のディレクトリとして使う。なければ 0o700 で作る（R22）。"""
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise GuardError(f"{path} は、自分だけが書ける実体のディレクトリではありません")


def _repo_key(main: Path) -> str:
    """置き場所のキー（R22）。元のチェックアウトの物理パスの最後の名前（英数字と ._- のほかは _ にし、先頭の . も _ にする）と、
    物理パスの sha256 の先頭 12 桁。"""
    real = os.path.realpath(main)
    name = re.sub(r"[^A-Za-z0-9._-]", "_", os.path.basename(real))
    if name.startswith("."):
        name = "_" + name[1:]
    return f"{name}-{hashlib.sha256(os.fsencode(real)).hexdigest()[:12]}"


def _worktree_dir(home: Path, main: Path) -> Path:
    """worktree を置くディレクトリ <ホーム>/.cc-worktrees/<キー>。確かめ終わった印のディレクトリも用意する。

    ホームは物理パスにする。Claude Code は、. や .. を含むパスと、symlink を通るパスを使わない。
    """
    base = Path(os.path.realpath(home)) / WORKTREE_BASE
    key = base / _repo_key(main)
    for d in (base, key, key / VERIFIED_DIR):
        _private_dir(d)
    return key


def _marker(place: Path) -> Path:
    return place.parent / VERIFIED_DIR / place.name


def _identity(place: Path) -> str:
    st = os.lstat(place)
    return f"{st.st_dev} {st.st_ino}\n"


def _verified(place: Path) -> bool:
    """place が、確かめ終わった印に書いたもの（st_dev, st_ino）と同じ、実体のディレクトリか。"""
    try:
        if not stat.S_ISDIR(os.lstat(place).st_mode):
            return False
        fd = os.open(_marker(place), os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as f:
            return f.read(64) == _identity(place).encode("ascii")
    except OSError:
        return False


def _mark_verified(place: Path) -> None:
    """確かめ終わった印を書く。途中で止められても半端な印が残らないよう、一時ファイルを os.replace で置き換える。"""
    marker = _marker(place)
    fd, tmp = tempfile.mkstemp(dir=marker.parent, prefix=".")
    try:
        with os.fdopen(fd, "w", encoding="ascii") as f:
            f.write(_identity(place))
        os.replace(tmp, marker)
    except BaseException:
        os.unlink(tmp)
        raise


def _discard(main: Path, place: Path, branch: str, base: str, stderr: TextIO, *, created: bool) -> None:
    """このフックが作った worktree とブランチを消す（R20。作る前に、どちらもないことを確かめてある）。

    created が偽（worktree add が 0 以外で終わった）なら、git が自分で作ったディレクトリと登録を消しているので、
    置き場所に今あるものは、このフックが作ったものではない。ブランチだけを、作成元を指しているときに消す（Minor 1）。
    git が途中で止められると lock（initializing）が残るので、remove に --force を 2 つ付ける。
    ほかの worktree が checkout しているブランチは、branch -D が消さない。
    """
    global _deadline
    if _deadline is not None:
        _deadline = max(_deadline, time.monotonic() + WORKTREE_DISCARD_TIME)
    left: list[str] = []
    if created:
        try:
            os.unlink(_marker(place))
        except FileNotFoundError:
            pass
        if os.path.lexists(place):
            _git_process(main, "worktree", "remove", "--force", "--force", str(place))
            if os.path.lexists(place):
                left.append(str(place))
    ref = f"refs/heads/{branch}"
    code = _git_process(main, "show-ref", "--verify", "--quiet", ref).returncode
    mine = code == 0
    if mine and not created:
        # 作成元を指していないものは、確かめた後に別のものが作ったブランチなので消さない。
        mine = os.fsdecode(_git_process(main, "show-ref", "--verify", "--hash", ref).stdout).strip() == base
    if code not in (0, 1) or (mine and _git_process(main, "branch", "-D", branch).returncode != 0):
        left.append(f"ブランチ {branch}")
    if left:
        stderr.write(MSG_WT_LEFT + "\n" + "".join(f"  {_show(x)}\n" for x in left))


def _uncommitted(inv: Invocation, paths: Sequence[str]) -> bool:
    """元のチェックアウトの paths に、コミットしていない変更（index かディスク）があるか。

    status は、作業ツリーと比べるときに設定の clean フィルタを動かすので使わない。中身はフィルタを通さずに比べる。
    """
    assert inv.root is not None
    head = tree_entries(inv.cwd, _head_tree(inv))
    index = index_entries(inv.root, root=inv.root, home=inv.home)
    disk = disk_entries(inv.root, paths)
    return any(disk[p] != index.get(p) or index.get(p) != head.get(p) for p in paths)


def _guidance(inv: Invocation, paths: Sequence[str], base: str, from_origin: bool) -> str:
    """違ったときの案内を 1 つ選ぶ。判断の順は plan の Task 4 の手順 7。"""
    if from_origin:
        prefix = "refs/remotes/origin/"
        target = _git_line(inv, "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD", ok=(0, 1))
        default = target[len(prefix):] if target.startswith(prefix) else None
        current = _current_branch(inv)
        if default is None or current != default:
            return MSG_WT_BRANCH.format(
                current=_show(current) if current is not None else "（ブランチなし）",
                origin=_show(target.removeprefix("refs/remotes/")) if target else "（ブランチを指していません）",
            )
    if _uncommitted(inv, paths):
        return MSG_WT_UNCOMMITTED
    if _rev(inv, "HEAD", "commit") != base:
        return MSG_WT_BEHIND
    return MSG_WT_REPLACED


def _refuse(inv: Invocation, changes: Sequence[Change], base: str, from_origin: bool, stderr: TextIO) -> int:
    assert inv.root is not None
    stderr.write(listing(Plan(root=inv.root, changes=tuple(changes), sources=())))
    stderr.write(_guidance(inv, [c.path for c in changes], base, from_origin) + "\n")
    return EXIT_STOP


def _worktree_create(payload: Mapping[str, object], stdout: TextIO, stderr: TextIO, home: Path) -> int:
    if not isinstance(payload, Mapping):
        raise GuardError("フックの入力を読めません")
    name, cwd = payload.get("name"), payload.get("cwd")
    if not isinstance(name, str) or NAME.match(name) is None:
        raise GuardError(f"worktree の名前 {name!r} は使えません" if isinstance(name, str) else "worktree の名前がありません")
    if not isinstance(cwd, str) or not os.path.isabs(cwd):
        raise GuardError("フックの入力に、カレントディレクトリの絶対パスがありません")
    main = _main_checkout(_hook_inv(Path(cwd), None, user_home()))
    if main is None:
        raise GuardError("bare のリポジトリには worktree を作れません")
    # 共通の gitdir は .git/commondir で別のリポジトリに向けられる（実測）。起動したディレクトリを含むものに限る。
    if _inside(cwd, main) is None:
        raise GuardError(f"{cwd} が元のチェックアウトの中にありません")
    place = _worktree_dir(home, main) / name
    inv = _hook_inv(main, main, user_home())
    if _registered(inv, str(place)):
        if not os.path.isdir(place) or os.path.islink(place):
            raise GuardError(f"{place} は登録された worktree ですが、ディレクトリがありません")
        if not _verified(place):
            # 作る途中で止められた worktree などは、確かめていない中身を持ちうる。消さずに案内する（R20）。
            remove = shlex.join(["git", "-C", str(main), "worktree", "remove", "--force", str(place)])
            drop = shlex.join(["git", "-C", str(main), "branch", "-D", f"worktree-{name}"])
            stderr.write(MSG_WT_UNVERIFIED.format(place=_show(str(place)), remove=_show(remove), branch=_show(drop)) + "\n")
            return EXIT_STOP
        # 確かめて作った worktree は、もう一度は確かめない（design 7 章）。
        stdout.write(f"{place}\n")
        return EXIT_ALLOW
    # 前からあるディレクトリとブランチは、このフックが作ったものではないので、触らずに止める（R20）。
    if os.path.lexists(place):
        raise GuardError(f"{place} がすでにあります")
    branch = f"worktree-{name}"
    if _branch_oid(inv, branch) is not None:
        # Claude Code の Remove worktree の後に同じ名前で作るときも、ここで止まる（Task 9 で確かめた）。
        drop = shlex.join(["git", "-C", str(main), "branch", "-D", branch])
        stderr.write(MSG_WT_BRANCH_EXISTS.format(branch=_show(branch), drop=_show(drop)) + "\n")
        return EXIT_STOP
    base = _rev(inv, "refs/remotes/origin/HEAD", "commit")
    from_origin = base is not None
    base = base or _rev(inv, "HEAD", "commit")
    if base is None:
        raise GuardError("作成元のコミットがありません")
    tree = _commit_tree(inv, base)
    changes = compare_with_main(main, main, tree)
    if changes:
        return _refuse(inv, changes, base, from_origin, stderr)
    # 新しい worktree には、元のチェックアウトと同じ中身の対象もすべて書かれ、属性はそれにも効く。
    fresh = Plan(root=place, changes=(), sources=(tree,), fresh=True, old_root=main)
    reason = _tree_danger(main, tree) or danger(fresh, inv)
    if reason is not None:
        stderr.write(reason + "\n")
        return EXIT_STOP
    # worktree add は、元のチェックアウトの gitdir（logs/refs/heads/<ブランチ> など）に書く（D2）。
    _check_gitdirs(inv)
    # 前に作った worktree の印が残っていれば消す。作る途中で止められたときに、古い印で確かめ済みとみなさない。
    try:
        os.unlink(_marker(place))
    except FileNotFoundError:
        pass
    if _deadline is not None and _deadline - time.monotonic() < WORKTREE_ADD_MIN:
        raise GuardError("worktree を作る時間が残っていません")
    # 作成元はコミットの oid で渡す（比べた後に ref を動かされても、比べたコミットから作る）。
    env = {**git_env(user_home()), "PATH": WORKTREE_ADD_PATH}
    try:
        cp = _git_process(main, "worktree", "add", "-b", branch, str(place), base, env=env, group=True)
    except BaseException:
        _discard(main, place, branch, base, stderr, created=True)
        raise
    if cp.returncode != 0:
        # git は失敗すると、自分で作ったディレクトリと登録を消し、-b で作ったブランチだけを残す（実測）。
        _discard(main, place, branch, base, stderr, created=False)
        raise GuardError("git worktree add が失敗しました")
    try:
        # 書かれた結果を比べる。比べた後の replace の ref や object の差し替えも、ここで見つかる。
        reason, diffs = _created_diff(main, place)
        if reason is None and not diffs:
            _mark_verified(place)
            stdout.write(f"{place}\n")
            stdout.flush()
            return EXIT_ALLOW
    except BaseException:
        _discard(main, place, branch, base, stderr, created=True)
        raise
    _discard(main, place, branch, base, stderr, created=True)
    if reason is not None:
        stderr.write(reason + "\n")
        return EXIT_STOP
    return _refuse(inv, diffs, base, from_origin, stderr)


def worktree_create(payload: Mapping[str, object], *, stdout: TextIO, stderr: TextIO,
                    home: Path | None = None) -> int:
    """claude -w の WorktreeCreate フック（design 6.6、R22）。対象のファイルが元のチェックアウトと同じときだけ、
    <home>/.cc-worktrees/<キー>/<名前> に作る。home は、なければ user_home()（テストで差し替える）。

    成功したら、置き場所の物理パスを標準出力の最後の行に出して 0 を返す。標準出力にはほかに何も出さず、
    文はすべて標準エラーに出す（R21）。失敗したら、作ったものを消して 1 を返す（fail closed）。
    このモードの git は、呼ばれてから WORKTREE_BUDGET 秒の期限の中で動かす。
    """
    global _deadline
    _deadline = time.monotonic() + WORKTREE_BUDGET
    try:
        return _worktree_create(payload, stdout, stderr, home if home is not None else user_home())
    except Refused as e:
        stderr.write(str(e) + "\n")
    except GuardError as e:
        stderr.write(MSG_ERROR.format(reason=_show(str(e))) + "\n")
    except Exception as e:
        stderr.write(MSG_ERROR.format(reason=type(e).__name__) + "\n")
    finally:
        _deadline = None
    return EXIT_STOP


def main(argv: list[str]) -> int:
    if argv == ["status"]:
        sys.stdout.write("sandbox: yes\n" if in_sandbox() else "sandbox: no\n")
        return 0
    if argv == ["worktree-create"]:
        try:
            payload = json.loads(sys.stdin.buffer.read())
        except Exception as e:
            sys.stderr.write(MSG_ERROR.format(reason=type(e).__name__) + "\n")
            return EXIT_STOP
        return worktree_create(payload, stdout=sys.stdout, stderr=sys.stderr)
    if len(argv) == 2 and argv[0] == "verify":
        return verify(argv[1], sys.stderr)
    if argv[:1] == ["check"] and "--" in argv:
        sep = argv.index("--")
        opts, git_args = argv[1:sep], argv[sep + 1:]
        names: tuple[str, ...] = ()
        i = 0
        while i < len(opts):
            if opts[i] == "--git-env" and i + 1 < len(opts):
                names = tuple(n for n in opts[i + 1].split(",") if n)
                i += 1
            else:
                return 1
            i += 1
        code, out = check(
            git_args, start=Path.cwd(), git_env=names, home=user_home(),
            stdin=sys.stdin, stderr=sys.stderr, tty=sys.stdin.isatty() and sys.stderr.isatty(),
        )
        sys.stdout.write(out)
        return code
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
