#!/usr/bin/env -i /Library/Developer/CommandLineTools/usr/bin/python3 -I
# 呼び出し元の環境変数を引き継がず、xcrun の shim（/usr/bin/python3）を通さずに起動する。
"""人間の git コマンドが、自動で読み込まれるファイルを書き換えないかを、実行の前に確かめる。

/usr/local/libexec/claude-guard/cc-checkout-guard に root 所有でインストールする。
sandbox の外で動くので、リポジトリの設定やフックを読まない git だけを使い、
確かめられない形はすべて止める（fail closed）。
claude -w の WorktreeCreate フック（worktree-create）として、確かめたうえで worktree を作ることもする。
"""
from __future__ import annotations

import os
import stat
import sys

# ここから fast_allow までは、重い import の前に読む（I2）。標準ライブラリの読み込みに 1 回あたり約 80 ms かかる。
# stat は os が読み込むので、時間は増えない。
EXIT_ALLOW = 0
EXIT_STOP = 1
GITFILE_MAX = 4096  # 読む .git ファイル・gitdir ファイル・commondir・HEAD の大きさの上限（バイト）
# 中のすべての entry を見る gitdir のディレクトリ（D2）。objects は直下だけを見る。
GITDIR_WALK = frozenset(("logs", "refs", "sequencer", "rebase-merge", "rebase-apply"))
HEX = frozenset(b"0123456789abcdefABCDEF")

# 作業ツリーに書かないサブコマンド。ファイルに書くオプション（file_writes）があれば止める。
READ_ONLY = frozenset(
    "add blame branch cat-file check-attr check-ignore check-mailmap check-ref-format "
    "cherry clone commit-graph commit-tree config count-objects describe diff diff-files "
    "diff-index diff-tree fetch for-each-ref fsck gc grep hash-object help init log "
    "ls-files ls-remote ls-tree maintenance merge-base merge-tree mktag mktree name-rev notes prune "
    "push range-diff reflog remote repack replace rev-list rev-parse shortlog show show-branch "
    "show-ref status symbolic-ref tag update-index update-ref var verify-commit verify-pack "
    "verify-tag version whatchanged write-tree".split()
)
# 中身をファイルに書く builtin（-o・--output-directory・create <file>）。確かめずに止める（C1）。
FILE_WRITERS = frozenset(("archive", "bundle", "format-patch"))
# 確認の内容を計算するサブコマンド（HANDLERS のキーと同じ）。早道は、これらの -h・--help だけを許可する。
HANDLED = frozenset(
    "commit switch checkout restore checkout-index reset merge pull stash cherry-pick revert rm clean mv "
    "worktree".split()
)
# 人間の環境にあってよい GIT_ の名前。
ALLOWED_GIT_ENV = frozenset(
    "GIT_EDITOR GIT_SEQUENCE_EDITOR GIT_PAGER GIT_SSH GIT_SSH_COMMAND GIT_ASKPASS GIT_TERMINAL_PROMPT "
    "GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL "
    "GIT_COMMITTER_DATE GIT_MERGE_AUTOEDIT GIT_PROGRESS_DELAY".split()
)
SKIPPED_GLOBALS = frozenset(("--no-pager", "-p", "--paginate", "--no-optional-locks"))
HELP_GLOBALS = frozenset(("--version", "--help", "-h"))


def file_writes(sub: str, args: Sequence[str]) -> str | None:
    """sub と args がファイルに書くなら、その理由（C1）。書かないなら None。

    --output は diff の系統（show・log・blame・range-diff など）で、引数を読む時点でファイルを作る（実測）。
    省略形（--outp）も止める。config の -f・--file は別のファイルを読み書きする。値をつないだ形（-fx）、
    まとめ書き（-lfx）、省略形（--fil）も止める。init の --separate-git-dir は、既存の .git（sandbox が書ける）を
    丸ごと動かし、--template は作り直しでもテンプレートを .git/hooks などに写す（実測。R24）。省略形も止める。
    人間の -c init.templateDir は、args に現れないので check が止める。-- の後も見る（止める側に倒す）。
    """
    if sub in FILE_WRITERS:
        return f"{sub} はファイルに書きます"
    if sub not in READ_ONLY:
        return None
    for tok in args:
        name = tok.partition("=")[0]
        long = name.startswith("--") and len(name) > 2
        if long and "--output".startswith(name):
            return f"{sub} の {name} はファイルに書きます"
        if sub == "config" and ((long and "--file".startswith(name))
                                or (tok.startswith("-") and not long and "f" in tok[1:])):
            return f"config の {name} はファイルに書きます"
        if sub == "init" and long and ("--separate-git-dir".startswith(name) or "--template".startswith(name)):
            return f"init の {name} はファイルに書きます"
    return None


def _odd(entry: os.DirEntry) -> bool:
    """symlink か、通常のファイルとディレクトリのほか（FIFO・ソケット・デバイス）か。"""
    return entry.is_symlink() or not (entry.is_file(follow_symlinks=False) or entry.is_dir(follow_symlinks=False))


def _odd_under(top: str, deep: bool) -> str | None:
    """top の中で最初に見つけた _odd な entry のパス。deep なら中のディレクトリもたどる（symlink はたどらない）。"""
    stack = [top]
    while stack:
        with os.scandir(stack.pop()) as it:
            for entry in it:
                if _odd(entry):
                    return entry.path
                if deep and entry.is_dir(follow_symlinks=False):
                    stack.append(entry.path)
    return None


def gitdir_problem(gitdir: str) -> str | None:
    """git が開いて書く gitdir の entry のうち、symlink か特殊なファイルの最初のパス（D2）。読めなければ OSError。

    git は COMMIT_EDITMSG・FETCH_HEAD・logs/HEAD・index などを、symlink をたどって書く（index などの lockfile も、
    symlink の先に作って置き換える）。symlink のディレクトリ（refs/heads・objects など）の中にも書く（実測）。
    名前の一覧に頼らず、最上位のすべての entry を見る。中まで見るのは、logs・refs・sequencer・rebase-merge・
    rebase-apply（すべて）と objects（直下だけ）。名前は大文字と小文字を区別せずに比べる（ファイルシステムが区別しない）。
    """
    with os.scandir(gitdir) as it:
        top = list(it)
    for entry in top:
        if _odd(entry):
            return entry.path
    for entry in top:
        name = entry.name.casefold()
        if entry.is_dir(follow_symlinks=False) and (name in GITDIR_WALK or name == "objects"):
            found = _odd_under(entry.path, deep=name != "objects")
            if found is not None:
                return found
    return None


def _small_file(path: str) -> bytes | None:
    """path を、symlink をたどらずに、通常のファイルとして GITFILE_MAX バイトまで読む。できなければ None。

    O_NONBLOCK で開くので、FIFO でも固まらない（種類を確かめてから読む）。
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        data = os.read(fd, GITFILE_MAX + 1)
    finally:
        os.close(fd)
    return data if len(data) <= GITFILE_MAX else None


def _git_directory(path: str) -> bool:
    """path が、git が gitdir として使う .git ディレクトリと言い切れるか。git の is_git_directory より狭く判定する。

    git は、HEAD が正しくないか、objects・refs をたどれない .git ディレクトリを使わずに、上を探す。
    """
    head = _small_file(os.path.join(path, "HEAD"))
    if head is None:
        return False
    if head.startswith(b"ref:"):
        if not head[4:].lstrip().startswith(b"refs/"):
            return False
    elif len(head) < 40 or not HEX.issuperset(head[:40]):
        return False
    if os.path.lexists(os.path.join(path, "commondir")):
        return False
    return all(os.path.isdir(p) and os.access(p, os.X_OK)
               for p in (os.path.join(path, "objects"), os.path.join(path, "refs")))


def _path_in(base: str, data: bytes) -> str | None:
    """git が .git ファイルと commondir を読むのと同じく、末尾の CR と LF を除き、相対パスなら base から読む。"""
    text = os.fsdecode(data.rstrip(b"\r\n"))
    return os.path.join(base, text) if text else None


def find_gitdirs(cwd: str) -> list[str] | None:
    """cwd の gitdir と共通の gitdir を、git を動かさずに、git と同じくファイルシステムから探す（D2。早道で使う）。

    カレントディレクトリの物理パスから上へ .git を探す。リポジトリの外なら []。git と同じと言い切れない形
    （.git が symlink か特殊なファイル、読めない .git ファイル、git が使うか分からない .git ディレクトリ、
    bare のリポジトリかもしれないディレクトリ）なら None。
    """
    path = os.path.realpath(cwd)
    while True:
        dotgit = os.path.join(path, ".git")
        try:
            st: os.stat_result | None = os.lstat(dotgit)
        except (FileNotFoundError, NotADirectoryError):
            st = None
        if st is not None:
            gitdir: str | None = None
            if stat.S_ISREG(st.st_mode):
                data = _small_file(dotgit)
                if data is not None and data.startswith(b"gitdir: "):
                    gitdir = _path_in(path, data[len(b"gitdir: "):])
            elif stat.S_ISDIR(st.st_mode) and _git_directory(dotgit):
                gitdir = dotgit
            if gitdir is None:
                return None
            common: str | None = gitdir
            if os.path.lexists(os.path.join(gitdir, "commondir")):
                data = _small_file(os.path.join(gitdir, "commondir"))
                common = _path_in(gitdir, data) if data is not None else None
            return None if common is None else [gitdir, common]
        if os.path.lexists(os.path.join(path, "HEAD")):
            return None  # bare のリポジトリかもしれない
        parent = os.path.dirname(path)
        if parent == path:
            return []
        path = parent


def _gitdirs_clean(cwd: str | None, moves: Sequence[str]) -> bool:
    """-C（moves）を当てたカレントディレクトリの gitdir と共通の gitdir に、gitdir_problem がないと言い切れるか（D2）。"""
    try:
        place = cwd if cwd is not None else os.getcwd()
        for value in moves:
            place = os.path.join(place, value)
        dirs = find_gitdirs(place)
        return dirs is not None and all(gitdir_problem(d) is None for d in dict.fromkeys(dirs))
    except (OSError, ValueError):
        return False


def fast_allow(argv: Sequence[str], cwd: str | None = None) -> bool:
    """check の引数だけで許可が決まるか（I2）。偽なら何も決めず、全体の処理（main）に任せる。

    許可するのは、全体の処理も許可する形だけ: READ_ONLY のサブコマンドでファイルに書かない形、
    HANDLED のサブコマンドの -h・--help、サブコマンドのない形（--version・--help など）。
    check のオプションと全体のオプションは main・parse と同じく読み、parse が止めるもの（-c alias.*、
    知らないオプション、ALLOWED_GIT_ENV にない名前）と、同じと言い切れないもの（ASCII でない -c の値、alias）は任せる。
    リポジトリの中身は読まない。READ_ONLY は作業ツリーに書かないので、許可にリポジトリの中身は要らない。
    許可する前に、-C を当てたカレントディレクトリの gitdir と共通の gitdir を、git を動かさずに確かめ、symlink などが
    あるか、git と同じと言い切れなければ任せる（D2。全体の処理は、sandbox の中なら許可し、外なら止める）。
    cwd は呼ばれたときのカレントディレクトリ（None なら os.getcwd()。テストで差し替える）。
    """
    if argv[:1] != ["check"] or "--" not in argv:
        return False
    sep = list(argv).index("--")
    opts, args = argv[1:sep], argv[sep + 1:]
    i = 0
    while i < len(opts):
        if opts[i] == "--git-env" and i + 1 < len(opts):
            if any(name and name not in ALLOWED_GIT_ENV for name in opts[i + 1].split(",")):
                return False
            i += 1
        else:
            return False
        i += 1
    i = 0
    moves: list[str] = []  # -C の値（git と同じ順に当てる）
    while i < len(args):
        tok = args[i]
        if tok in HELP_GLOBALS:
            break
        if tok in ("-C", "-c"):
            if i + 1 >= len(args):
                return False
            # parse は、NFC と casefold の後に alias. で始まる -c を止め、check は init の -c init.templateDir を止める。
            # ASCII なら lower と同じになる。
            value = args[i + 1]
            if tok == "-c" and (not value.isascii() or value.lower().startswith("alias.")
                                or value.lower().partition("=")[0] == "init.templatedir"):
                return False
            if tok == "-C":
                moves.append(value)
            i += 2
        elif tok in SKIPPED_GLOBALS:
            i += 1
        elif tok.startswith("-"):
            return False
        else:
            # git は builtin を alias で置き換えないので、名前だけで決まる。
            rest = args[i + 1:]
            if tok in READ_ONLY:
                if file_writes(tok, rest) is not None:
                    return False
            elif not (tok in HANDLED and rest[:1] in (["-h"], ["--help"])):
                return False
            break
    # 許可する形。gitdir を確かめてから許可する（D2）。
    return _gitdirs_clean(cwd, moves)


# 確認コマンドとして起動されたときだけ（check-repo.py とテストの import では動かさない）、
# 引数だけで許可が決まれば、重い import の前に終える。標準出力には何も出さない（verify は要らない）。
if __name__ == "__main__" and fast_allow(sys.argv[1:]):
    sys.exit(EXIT_ALLOW)

