{
    "workbench.colorTheme": "GitHub Dark Dimmed",
    // Ghostty（ghostty/config）と同じ配色にそろえる。追加は青、削除は赤にして、緑と赤の対比に頼らない。
    "workbench.colorCustomizations": {
        "[GitHub Dark Dimmed]": {
            // 背景: テーマの #22272e は白っぽいので、Ghostty と同じ #181d1f にする。
            // サイドバー・パネル・タブの列は、テーマと同じ明るさの差で、エディタより暗くする。
            "editor.background": "#181d1f",
            "tab.activeBackground": "#181d1f",
            "tab.hoverBackground": "#181d1f",
            "tab.activeBorder": "#181d1f",
            "tab.unfocusedActiveBorder": "#181d1f",
            "titleBar.activeBackground": "#181d1f",
            "activityBar.background": "#181d1f",
            "statusBar.background": "#181d1f",
            "statusBar.noFolderBackground": "#181d1f",
            "input.background": "#181d1f",
            "peekViewResult.background": "#181d1f",
            "sideBar.background": "#121719",
            "sideBarSectionHeader.background": "#121719",
            "panel.background": "#121719",
            "editorGroupHeader.tabsBackground": "#121719",
            "tab.inactiveBackground": "#121719",
            "titleBar.inactiveBackground": "#121719",
            "textBlockQuote.background": "#121719",
            "editorOverviewRuler.border": "#121719",
            // 文字色: テーマの #adbac7 は白く強いので、Ghostty と同じ #9aa7b4 にする（構文の色は editor.tokenColorCustomizations）。
            "editor.foreground": "#9aa7b4",
            // カーソル・選択・検索: カーソルと選択は Ghostty と同じ色。検索は、青の選択と見分けられるよう黄にする。
            "editorCursor.foreground": "#3fade5",
            "editor.selectionBackground": "#1a4d74", // 選択中テキスト
            "editor.selectionHighlightBackground": "#3d4242d0", // 選択中テキストと同じテキストのハイライト
            "editor.findMatchBackground": "#805400", // 検索ヒットの内、現在、フォーカスしているもの
            "editor.findMatchHighlightBackground": "#ae7c1466", // 検索にヒットしたテキストと同じテキスト
            // 差分・ガター・git: 追加の緑を青にする（削除の赤はテーマのまま）。
            // ミニマップと概要ルーラーの追加の色は、ガターの色から決まる。
            "diffEditor.insertedLineBackground": "#316dca26",
            "diffEditor.insertedTextBackground": "#539bf54d",
            "editorGutter.addedBackground": "#4184e466",
            "gitDecoration.addedResourceForeground": "#539bf5",
            "gitDecoration.untrackedResourceForeground": "#539bf5",
            "chat.linesAddedForeground": "#539bf5",
            // 統合ターミナル: Ghostty と同じ色にする。テーマの 16 色のうち、Ghostty と違う 5 色を上書きする。
            "terminal.background": "#181d1f",
            "terminal.foreground": "#9aa7b4",
            "terminal.ansiBlack": "#545d68",
            "terminal.ansiBrightBlack": "#636e7b",
            "terminal.ansiCyan": "#39c5cf",
            "terminal.ansiBrightCyan": "#56d4dd",
            "terminal.ansiBrightWhite": "#cdd9e5",
            "terminal.selectionBackground": "#1a4d74",
            "terminal.selectionForeground": "#f4f7fa",
            "terminalCursor.foreground": "#3fade5",
            "terminalCursor.background": "#181d1f" // ブロックカーソルの下の文字の色
        }
    },
    // 構文の色: テーマの白（#adbac7）・青（#6cb6ff・#96d0ff）・オレンジ（#f69d50）を、Ghostty の文字色と同じ量
    // （OKLab の明るさで -0.06）暗くする。文字列などの水色（#96d0ff）は眩しいので、明るさをもう少し下げ、彩度も 15% 下げる。
    // キーワードの赤（#f47067）も暗くする（明るさで -0.04）。オレンジだけ暗くすると、1 型・2 型の見え方で赤と見分けにくくなるため。
    // セレクタは、テーマ（GitHub Dark Dimmed 6.3.5）で最終的にその色になるもの。
    // 太字（markup.bold）は、Ghostty の bold-color と同じく #adbac7 のまま、通常の文字より少し明るく残す。
    "editor.tokenColorCustomizations": {
        "[GitHub Dark Dimmed]": {
            "textMateRules": [
                {
                    "scope": [
                        "entity.name.constant",
                        "variable.parameter.function",
                        "meta.jsx.children",
                        "meta.block",
                        "meta.tag.attributes",
                        "meta.object.member",
                        "meta.embedded.expression",
                        "storage.modifier.package",
                        "storage.modifier.import",
                        "storage.type.java",
                        "variable.other",
                        "markup.italic"
                    ],
                    "settings": {
                        "foreground": "#9aa7b4"
                    }
                },
                {
                    "scope": [
                        "constant",
                        "variable.other.constant",
                        "variable.other.enummember",
                        "variable.language",
                        "entity",
                        "support",
                        "meta.property-name",
                        "string variable",
                        "support.constant",
                        "support.variable",
                        "meta.module-reference",
                        "markup.heading",
                        "markup.heading entity.name",
                        "markup.inline.raw",
                        "meta.diff.header",
                        "meta.separator",
                        "meta.output"
                    ],
                    "settings": {
                        "foreground": "#59a3ea"
                    }
                },
                {
                    "scope": [
                        "string",
                        "string punctuation.section.embedded source",
                        "source.regexp",
                        "string.regexp",
                        "string.regexp.character-class",
                        "string.regexp source.ruby.embedded",
                        "string.regexp string.regexp.arbitrary-repitition",
                        "constant.other.reference.link",
                        "string.other.link"
                    ],
                    "settings": {
                        "foreground": "#86b5dd"
                    }
                },
                {
                    "scope": [
                        "entity.name",
                        "meta.export.default",
                        "meta.definition.variable",
                        "variable",
                        "punctuation.definition.list.begin.markdown",
                        "markup.changed",
                        "punctuation.definition.changed"
                    ],
                    "settings": {
                        "foreground": "#e18a3b"
                    }
                },
                {
                    "scope": [
                        "constant.other.placeholder",
                        "constant.character",
                        "keyword",
                        "storage",
                        "storage.type",
                        "punctuation.section.embedded"
                    ],
                    "settings": {
                        "foreground": "#e7645c"
                    }
                }
            ]
        }
    },
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.iconTheme": "catppuccin-perfect-dark",
    "workbench.startupEditor": "none",
    "editor.rulers": [
        110
    ],
    "editor.fontFamily": "Fira Code, HackGen35Nerd, Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 13,
    "editor.fontLigatures": true,
    "editor.renderWhitespace": "all",
    "editor.tabSize": 2,
    "editor.formatOnType": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.renderControlCharacters": true,
    "editor.renderLineHighlight": "all",
    "editor.largeFileOptimizations": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnPaste": true,
    "editor.suggest.filterGraceful": false,
    "diffEditor.renderSideBySide": false,
    "diffEditor.codeLens": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "explorer.autoReveal": false,
    "explorer.confirmDragAndDrop": false,
    "extensions.ignoreRecommendations": true,
    "files.autoSave": "afterDelay",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.painless": "groovy",
        "*.schema": "ruby",
        "*.html.erb": "erb",
        ".forceignore": "ignore"
    },
    "files.watcherExclude": {
        "/vendor/bundle/**": true,
        "/node_modules/**": true,
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/Applications/**": true,
        "**/Creative Cloud Files/**": true,
        "**/Library/**": true,
        "**/Dropbox/**": true,
        "**/Desktop/**": true,
        "**/Downloads/**": true,
        "**/Documents/**": true,
        "**/Music/**": true,
        "**/Pictures/**": true,
        "**/Public/**": true
    },
    "files.exclude": {
        "**/.hg": false,
        "/.DS_Store": true,
        "/.git": true,
        "/node_modules": true
    },
    "git.openRepositoryInParentFolders": "always",
    "search.exclude": {
        "/node_modules": true,
        "/vendor": true
    },
    "task.slowProviderWarning": true,
    "terminal.integrated.copyOnSelection": true,
    "terminal.external.osxExec": "iTerm.app",
    "window.commandCenter": true,
    "better-comments.tags": [
        {
            "tag": "TODO:",
            "color": "#000",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#FFAB00",
            "bold": true,
            "italic": false
        },
        {
            "tag": "FIXME:",
            "color": "#fff",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#FF4180",
            "bold": true,
            "italic": false
        },
        {
            "tag": "NOTE:",
            "color": "#000",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#97DFFC",
            "bold": true,
            "italic": false
        }
    ],
    "mise.checkForNewMiseVersion": false,
    // autoDocstring のスタイルを Google スタイルに設定する。
    "autoDocstring.docstringFormat": "google",
    //
    // --------------------------------------------------------------------
    // JSON Schema
    // --------------------------------------------------------------------
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/catppuccin/vscode/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://biomejs.dev": true
    },
    "[json]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
    },
    //
    // --------------------------------------------------------------------
    // Ruby
    // --------------------------------------------------------------------
    "[ruby]": {
        "editor.defaultFormatter": "Shopify.ruby-lsp",
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
    },
    "rubyLsp.rubyVersionManager": {
        "identifier": "mise"
    },
    "rubyLsp.formatter": "rubocop",
    "rubyLsp.linters": [
        "rubocop"
    ],
    "[erb]": {
        "editor.defaultFormatter": "aliariff.vscode-erb-beautify",
        "editor.formatOnSave": false
    },
    "vscode-erb-beautify.keepBlankLines": 1,
    // VSCode ERB Formatter/Beautify 拡張で使用する HTML フォーマッター: htmlbeautifier gem は、
    // ローカル環境へインストールして使用する。 gem install htmlbeautifier -N
    "vscode-erb-beautify.useBundler": false,
    //
    // --------------------------------------------------------------------
    // Terraform
    // --------------------------------------------------------------------
    "terraform.languageServer.enable": true,
    // ここは、絶対パスで設定する必要がある。通常は $PATH から自動検出される
    // "terraform.languageServer.terraform.path": "~/.local/share/mise/shims/terraform",
    "terraform.languageServer.args": [
        "serve"
    ],
    "terraform.experimentalFeatures.validateOnSave": false,
    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file"
    },
    //
    // --------------------------------------------------------------------
    // Trivy
    // --------------------------------------------------------------------
    "trivy.misconfigScanning": true,
    "trivy.vulnScanning": false,
    "trivy.secretScanning": false,
    "trivy.minimumReportedSeverity": "UNKNOWN",
    "trivy.useAquaPlatform": false,
    //
    // --------------------------------------------------------------------
    // JavaScript, TypeScript
    // --------------------------------------------------------------------
    "[javascript][javascriptreact][typescript][typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.biome": "explicit"
        }
    },
    //
    // --------------------------------------------------------------------
    // Python
    // --------------------------------------------------------------------
    // ここは、絶対パスで設定する必要がある。通常は $PATH から自動検出される。
    // "python.defaultInterpreterPath": "~/.local/share/mise/installs/python/latest",
    "python.analysis.extraPaths": [
        // NOTE: Python のバージョンを変更した場合は、併せて下記パス内 "python3.11" も変更する必要あり。
        ".venv/lib/python3.11/site-packages"
    ],
    // NOTE: Ruff は .flake8 を読まないので、その設定は pyproject.toml に記述する必要がある。
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        // 明示的な保存時に、Ruff で import を並べ替える。
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    // 型チェックは、引き続き mypy を使用する。
    "mypy-type-checker.args": [
        "--follow-imports=skip", // インポートしたモジュールの型ヒントチェックを行わない。
        "--ignore-missing-imports", // 解決できないモジュールのインポートを無視する。
        "--show-column-numbers", // エラーメッセージにカラム・オフセットも表示するようにする。
        "--warn-return-any", // 返り値が正確に明示されていないことを警告する。
        "--disallow-untyped-defs", // 返り値が明示されていない関数をエラーとして扱う。
        "--disallow-untyped-calls" // 返り値の型をが明示されていない関数をエラーとして扱う。
    ],
    "mypy-type-checker.path": [
        ".venv/bin/mypy"
    ],
    "mypy-type-checker.severity": {
        "error": "Warning"
    },
    //
    // --------------------------------------------------------------------
    // HTML, Markdown, etc...
    // --------------------------------------------------------------------
    "html.format.wrapLineLength": 0,
    "[html]": {
        "editor.defaultFormatter": null
    },
    "markdown.validate.enabled": false,
    // Markdown 内で HTML リンクを使用するため、下記の警告を無効化する。
    "markdown.validate.fragmentLinks.enabled": "ignore",
    "markdown.validate.fileLinks.markdownFragmentLinks": "ignore",
    "[markdown]": {
        "files.trimTrailingWhitespace": false,
        "editor.wordWrap": "off",
        "editor.formatOnPaste": false,
        "editor.formatOnType": false,
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml",
        "editor.formatOnSave": true
    },
    "xml.format.maxLineWidth": 120,
    "xml.format.splitAttributes": "preserve",
    "xml.format.preserveEmptyContent": true,
    "spectral.validateLanguages": [
        "yaml",
        "json"
    ],
    "spectral.validateFiles": [
        "dist/**/openapi.yaml",
        "dist/**/openapi.yml"
    ],
    // mise でインストールした Java を認識させるための設定。
    "salesforcedx-vscode-apex.java.home": "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home",
    "hediet.vscode-drawio.resizeImages": null,
    "projectManager.tags": [
        "Personal",
        "KSC",
        "HomeLoan",
        "HomeLoan/Infra",
        "NUMM"
    ],
    // Claude Code
    "claudeCode.preferredLocation": "sidebar",
    "claudeCode.hideOnboarding": true,
    "chat.viewSessions.orientation": "stacked",
    // --------------------------------------------------------------------
    // ローカルファイルプロトコルの扱いに対する確認ダイアログを表示しない。
    "security.promptForLocalFileProtocolHandling": false,
    "spreadjs.ribbonMode": "classic",
    "xml.server.vmargs": "-Xmx1024M"
}
