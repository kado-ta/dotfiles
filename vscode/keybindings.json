// ~/Library/Application\ Support/Code/User/keybindings.json
//
// 既定値を上書きするには、このファイル内にキー バインドを挿入します
[
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.previousEditor"
  },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.nextEditor"
  },
  // .md ファイルを開いた状態から Cmd+Opt+T キーで、そのファイルを Typora で開く。
  // 言語 ID（instructions, chatagent, skill など）によらず拡張子で判定する。
  // エクスプローラーの選択項目とタスクの ${file} がずれないよう、エディタにフォーカスがあるときに限る。
  {
    "key": "cmd+alt+t",
    "command": "workbench.action.tasks.runTask",
    "args": "Open current Markdown in Typora",
    "when": "editorFocus && resourceExtname == .md"
  },
  {
    "key": "cmd+alt+t",
    "command": "-workbench.action.closeOtherEditors"
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b\r"
    },
    "when": "terminalFocus"
  }
]
