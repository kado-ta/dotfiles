# Codex の execpolicy の規則（dotfiles で管理する）。
# codex/setup.sh が検査してから ~/.codex/rules/dotfiles.rules にコピーする。Codex はリンクを読まない。
# ~/.codex/rules/default.rules は、TUI の「今後は聞かない」の書き込み先なので使わない。
#
# - decision は prompt だけにする。allow は、当たったコマンドを sandbox の外で確認なしに動かすので書かない
#   （setup.sh も allow を含むファイルは入れない）。decision を省くと allow になるので、必ず書く。
# - 規則に当たるコマンドには、TUI が「今後は聞かない」を提案しない。すでにある allow の規則にも prompt が勝つ。
# - pattern は位置で決まる前方一致。`git -C <dir> ...`・`git -c k=v ...` のように、サブコマンドの前に
#   オプションがある形と、変数・リダイレクト・`$(...)` を含むシェルのスクリプトには当たらない。
#   それらは developer_instructions の文章に任せる。
# - host_executable() は定義しない。定義すると、書いていない場所の実行ファイルが規則に当たらなくなる。
# - 規則を変えたら codex/setup.sh を実行し直す。読み込みに失敗すると codex exec と codex review が止まる。
# - 経緯と実測: docs/work/20261126_codex-rules/plan.md

# 未追跡のファイルを消す。workspace-write の sandbox の中でも確認なしに動く（2026-11-26 に実測）。
prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "git clean は未追跡のファイルを消し、元に戻せない。実行の前にユーザーの承認を得る。",
    match = [
        ["git", "clean", "-fd"],
        ["git", "clean", "-fdx"],
        ["git", "clean", "-n"],
        ["/usr/bin/git", "clean", "-fd"],
    ],
    not_match = [
        ["git", "status"],
        ["git", "diff"],
        ["git", "log"],
        ["git", "show"],
    ],
)

# 再帰の削除。sandbox の中でも確認なしに動く（実測）。-rf・-fr・--force など f を含む形は、
# Codex の組み込みの判定が確認にするので、最初の引数が -r・-R・--recursive の形だけを書く。
prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive"]],
    decision = "prompt",
    justification = "再帰の rm はディレクトリごと消す。実行の前にユーザーの承認を得る。",
    match = [
        ["rm", "-r", "dir"],
        ["rm", "-R", "dir"],
        ["rm", "--recursive", "dir"],
        ["rm", "-r", "-f", "dir"],
        ["/bin/rm", "-r", "dir"],
    ],
    not_match = [
        ["rm", "file.txt"],
        ["rm", "-rf", "dir"],
        ["rm", "-v", "-r", "dir"],
    ],
)

# 以下は、今は sandbox が止める（.git が読み取り専用、ネットワークが無効）。昇格の確認で
# 「今後は聞かない」を選ぶと allow が書かれ、以後は確認なしに sandbox の外で動くので、それを防ぐ。

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "push は明示的に依頼された場合だけ行う。main・master・staging へは push しない。force push は対象と影響を説明して承認を得る。",
    match = [
        ["git", "push"],
        ["git", "push", "origin", "main"],
        ["git", "push", "--force", "origin", "topic"],
    ],
    not_match = [
        ["git", "pull"],
        ["git", "fetch"],
        ["git", "status"],
        ["git", "log"],
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "git reset --hard は未コミットの変更を破棄する。実行の前にユーザーの承認を得る。",
    match = [
        ["git", "reset", "--hard"],
        ["git", "reset", "--hard", "HEAD~1"],
    ],
    not_match = [
        ["git", "reset"],
        ["git", "reset", "--soft", "HEAD~1"],
        ["git", "reset", "HEAD", "file.txt"],
        ["git", "status"],
    ],
)

prefix_rule(
    pattern = ["git", "checkout", ["--", "."]],
    decision = "prompt",
    justification = "この git checkout は未コミットの変更を破棄する。実行の前にユーザーの承認を得る。",
    match = [
        ["git", "checkout", "--", "file.txt"],
        ["git", "checkout", "."],
    ],
    not_match = [
        ["git", "checkout", "main"],
        ["git", "checkout", "-b", "topic"],
        ["git", "diff"],
    ],
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "prompt",
    justification = "git restore は未コミットの変更を破棄しうる。実行の前にユーザーの承認を得る。",
    match = [
        ["git", "restore", "file.txt"],
        ["git", "restore", "."],
        ["git", "restore", "--staged", "file.txt"],
    ],
    not_match = [
        ["git", "status"],
        ["git", "diff"],
        ["git", "show"],
    ],
)

prefix_rule(
    pattern = ["terraform", ["apply", "destroy"]],
    decision = "prompt",
    justification = "terraform apply・destroy は実際のインフラを変える。対象と影響を説明し、明示的な承認を得る。",
    match = [
        ["terraform", "apply"],
        ["terraform", "apply", "-auto-approve"],
        ["terraform", "destroy"],
    ],
    not_match = [
        ["terraform", "plan"],
        ["terraform", "init"],
        ["terraform", "validate"],
        ["terraform", "fmt"],
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "マージは明示的に依頼された場合だけ行う。",
    match = [
        ["gh", "pr", "merge"],
        ["gh", "pr", "merge", "123", "--squash"],
    ],
    not_match = [
        ["gh", "pr", "view", "123"],
        ["gh", "pr", "list"],
        ["gh", "pr", "checks"],
        ["gh", "pr", "diff"],
    ],
)
