# checkout は switch / restore に分割された。この分割後コマンドが推奨されている。
# restore は 2文字のエイリアスを作成しづらいので、そのまま使用する。
[alias]
	st = status
	br = branch -vv
	df = diff
	co = checkout
	sw = switch
	cm = commit
	gr = grep
[merge]
	ff = false
[pull]
	ff = only
[push]
# git push で自動的に upstream が紐づく。 git push origin <branch_name> の場合は、この設定は効かない。
	autoSetupRemote = true
[user]
	name = kado-ta
	email = 13118071+kado-ta@users.noreply.github.com
[secrets]
	providers = git secrets --aws-provider
	patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
	patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
	patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
[init]
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[includeIf "gitdir:~/Dev/numm/"]
	path = ~/.gitconfig_numm
[core]
	quotePath = false
[rerere]
# sandbox は .git/rr-cache と MERGE_RR に書ける。rerere が動くと、sandbox の外の git がその解決を任意のパスに書く。
# 設定がなくても rr-cache があれば動くので、false にする（check-repo.py が確かめる）。include に上書きされないよう、最後に置く。
	enabled = false
