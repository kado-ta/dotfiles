[alias]
	st = status
	br = branch -vv
	df = diff
	co = checkout
	sw = switch
	cm = commit
	gr = grep
	re = remote -v
[merge]
	ff = false
[rerere]
# sandbox が .git/rr-cache と MERGE_RR に置いた解決を、sandbox の外の git が任意のパスに書かないようにする。
# 設定がなくても rr-cache があれば動くので、false にする（cc-checkout-guard も止める。check-repo.py が確かめる）。
	enabled = false
[pull]
	ff = only
[push]
# git push で自動的に upstream が紐づく。 git push origin <branch_name> の場合は、この設定は効かない。
	autoSetupRemote = true
[user]
	name = kado-ta
	email = 13118071+kado-ta@users.noreply.github.com
[secrets]
	providers = git secrets --aws-provider
	patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
	patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
	patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
[init]
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[includeIf "gitdir:~/Dev/numm/"]
	path = ~/.gitconfig_numm
[core]
	quotePath = false
