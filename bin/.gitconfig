# checkout は switch / restore に分割された。この分割後コマンドが推奨されている。
# restore は 2文字のエイリアスを作成しづらいので、そのまま使用する。
[alias]
	st = status
	br = branch -vv
	df = diff
	co = checkout
	sw = switch
	cm = commit
	gr = grep
[merge]
	ff = false
[pull]
	ff = only
[push]
# git push で自動的に upstream が紐づく。 git push origin <branch_name> の場合は、この設定は効かない。
	autoSetupRemote = true
[user]
	name = kado-ta
	email = 13118071+kado-ta@users.noreply.github.com
[init]
	defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[color "diff"]
# 追加行は、削除行の赤と見分けやすいよう、緑ではなく明るい青にする（Claude Code の差分の配色と同じ考え方）。
# @@ の行は、既定のシアンが文字色と見分けにくいので、マゼンタにする。
	new = brightblue
	frag = magenta
[color "status"]
# ステージした変更は、ステージしていない変更の赤と見分けやすいよう、差分の追加行と同じ明るい青にする。
# status -sb の自分のブランチは、git branch の現在のブランチと同じ明るい青の太字にする。
	added = brightblue
	localBranch = brightblue bold
[color "decorate"]
# git log のローカルのブランチは、リモートのブランチの赤と見分けやすいよう、git branch の現在のブランチと同じ明るい青の太字にする。
	branch = brightblue bold
[color "branch"]
# 現在のブランチは明るい青の太字、ほかのワークツリーで使われているブランチ（+）は明るい黄にする。
# 既定の緑は暗く、シアンは文字色と見分けにくいため。
	current = brightblue bold
	worktree = brightyellow

[includeIf "gitdir:~/Dev/numm/"]
	path = ~/.gitconfig_numm
[core]
	quotePath = false
[rerere]
# sandbox は .git/rr-cache と MERGE_RR に書ける。rerere が動くと、sandbox の外の git がその解決を任意のパスに書く。
# 設定がなくても rr-cache があれば動くので、false にする（check-repo.py が確かめる）。include に上書きされないよう、最後に置く。
	enabled = false
