# =============================================================================
# Font
# =============================================================================
# HackGen Nerd は Starship のアイコン表示に必要
font-family = Fira Code
font-family = HackGen Console NF
font-size = 12
font-feature = +calt
font-feature = +liga
# 太字は Fira Code と PlemolJP Console の SemiBold にする。HackGen には Regular と Bold しかなく、
# 日本語の Bold が潰れて読みにくいため。通常の文字は font-family のフォントのまま。
font-family-bold = Fira Code
font-family-bold = PlemolJP Console
font-style-bold = SemiBold
# 行間を広げる。セルの高さを 5% 増やし、文字はセルの上下中央に置かれる。
adjust-cell-height = 5%

# =============================================================================
# Window
# =============================================================================
window-width = 200
window-height = 63
window-padding-x = 4
window-padding-y = 4
window-padding-color = extend
background-opacity = 0.97

# =============================================================================
# Terminal
# =============================================================================

# 作業ディレクトリを指定
working-directory = ~/Dev

# 新規ウィンドウは、常に上記の作業ディレクトリで開始
window-inherit-working-directory = false

# 新規タブ・Split は現在のウィンドウのディレクトリを引き継ぐ
tab-inherit-working-directory = true
split-inherit-working-directory = true

# 20MiB, バイト数で設定する
scrollback-limit = 20971520

shell-integration = zsh
shell-integration-features = no-cursor

# =============================================================================
# macOS
# =============================================================================
macos-titlebar-style = transparent
# bindkey -e（emacs キーバインド）で Option+key を Alt として使うために必要
# 右 Option は macOS の記号入力（例: @, []）に使えるよう left のみ有効化
macos-option-as-alt = left

# =============================================================================
# Cursor
# =============================================================================
cursor-color = #3fade5
# カーソルの下の文字は、セルの背景色にする。テーマ（GitHub Dark Dimmed）の #93dbff のままだと、
# 上の cursor-color とのコントラストが 1.66 しかなく、ブロックカーソルの下の文字が読めないため。
cursor-text = cell-background
cursor-style = block
cursor-style-blink = true

# マウスによるカーソル移動を無効化
cursor-click-to-move = false

# =============================================================================
# Keybindings
# =============================================================================
keybind = super+left=previous_tab
keybind = super+right=next_tab

# split を方向で移るキー（既定の goto_split:up/down/left/right）を無効にする。split は cmd+[ / ] で順に移る。
# cmd+option+←/→ は herdr のタブ移動に使うので、unbind で herdr に渡す（config/herdr/config.toml）。
# cmd+option+↑/↓ は herdr も使わないので、ignore で捨てる（unbind だとペインの中のシェルまで届く）。
keybind = super+alt+arrow_up=ignore
keybind = super+alt+arrow_down=ignore
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind

# Ghostty 検索欄へ Cmd + v でクリップボードの内容を貼り付けられるようにする。
keybind = super+v=paste_from_clipboard

# =============================================================================
# Clipboard
# =============================================================================
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-bracketed-safe = true
clipboard-paste-protection = true

# =============================================================================
# Colors
# =============================================================================
theme = GitHub Dark Dimmed
# テーマの背景の白っぽさを黒くして落ち着かせる。
background = #181d1f
# テーマの文字色が白くコントラストが強いのを少し暗くして落ち着かせる。
foreground = #9aa7b4
# 太字は #9aa7b4 より少し明るくする。
bold-color = #adbac7
selection-background = #1a4d74
selection-foreground = #f4f7fa

# =============================================================================
# Notifications
# =============================================================================
# フォーカスが外れているときにコマンド完了を通知
notify-on-command-finish = unfocused
